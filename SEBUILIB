        settingsApi.ConfigLoadEvent = Signal.new()
        settingsApi.ConfigSaveEvent = Signal.new()
        settingsApi.ConfigDeleteEvent = Signal.new()
        settingsApi.ConfigRefreshEvent = Signal.new()

