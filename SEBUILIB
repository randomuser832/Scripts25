            local name = nameBox.Get()
            settingsApi.ConfigCreateEvent:Fire(name)
            if name and name ~= "" then
                local ok = api.SaveConfig(name)
                refreshDropdown()
                configDropdown.Set(name)
                api.Notify({ title = "Config", text = ok and ("Created \"" .. name .. "\".") or "Couldn't save (no executor file access?)." })
            end
        end)
        local CONFIG_PLACEHOLDER = "..."
        local function hasValidSelection()
            local v = configDropdown.Value
            return v ~= nil and v ~= CONFIG_PLACEHOLDER
        end

        loadBtn.Event:Connect(function()
            settingsApi.ConfigLoadEvent:Fire(configDropdown.Value)
            if hasValidSelection() then
                local ok = api.LoadConfig(configDropdown.Value)
                api.Notify({ title = "Config", text = ok and ("Loaded \"" .. configDropdown.Value .. "\".") or "Couldn't load that config." })
            else
                api.Notify({ title = "Config", text = "Select a config first." })
            end
        end)
        saveBtn.Event:Connect(function()
            settingsApi.ConfigSaveEvent:Fire(configDropdown.Value)
            if hasValidSelection() then
                local ok = api.SaveConfig(configDropdown.Value)
                api.Notify({ title = "Config", text = ok and ("Saved \"" .. configDropdown.Value .. "\".") or "Couldn't save that config." })
            else
                api.Notify({ title = "Config", text = "Select a config first." })
            end
        end)
        deleteBtn.Event:Connect(function()
            settingsApi.ConfigDeleteEvent:Fire(configDropdown.Value)
            if hasValidSelection() then
                local deletedName = configDropdown.Value
                api.DeleteConfig(deletedName)
                refreshDropdown()
                configDropdown.Set(CONFIG_PLACEHOLDER, true)
                api.Notify({ title = "Config", text = "Deleted \"" .. deletedName .. "\"." })
            else
                api.Notify({ title = "Config", text = "Select a config first." })
            end
        end)
        refreshBtn.Event:Connect(function()
            settingsApi.ConfigRefreshEvent:Fire()
            refreshDropdown()
        end)
        refreshDropdown()

        keybind.Event:Connect(function(key) api.SetMenuKeybind(key) end)
        unloadBtn.Event:Connect(function() api.Destroy() end)

        function settingsApi.SetConfigList(list) configDropdown.SetOptions(list) end
        settingsApi.Tab = tab
        settingsApi.MenuKeybind = keybind
        settingsApi.ConfigDropdown = configDropdown
        settingsApi.NotificationPositionDropdown = notifPosDropdown
        return settingsApi
    end

    local menuKeyCode = Enum.KeyCode.RightControl
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == menuKeyCode then
            api.Toggle()
        end
    end)
    function api.SetMenuKeybind(keyCodeName)
        local ok, code = pcall(function() return Enum.KeyCode[keyCodeName] end)
        if ok and code then menuKeyCode = code end
    end

    function api.Open() glow.Visible = true end
    function api.Close() glow.Visible = false end
    function api.Toggle() glow.Visible = not glow.Visible end
    function api.SetPosition(pos) glow.Position = pos end
    function api.Destroy()
        glow:Destroy()
        notifContainer:Destroy()
    end

    api.Instance = window
    return api
end

return Library
