------------------------------------------------------------------
-- Two-column, auto-balancing category layout — used once per tab page
------------------------------------------------------------------

local function BuildCategoryPage(parentFrame, registerFlag)
    local pageApi = {}

    local columnGap = 12
    local leftCol = Instance.new("ScrollingFrame")
    leftCol.BackgroundTransparency = 1
    leftCol.BorderSizePixel = 0
    leftCol.Size = UDim2.new(0.5, -columnGap / 2, 1, 0)
    leftCol.CanvasSize = UDim2.new(0, 0, 0, 0)
    leftCol.AutomaticCanvasSize = Enum.AutomaticSize.Y
    leftCol.ScrollBarThickness = 3
    leftCol.ScrollBarImageColor3 = Theme.Accent
    leftCol.Parent = parentFrame

    local rightCol = Instance.new("ScrollingFrame")
    rightCol.BackgroundTransparency = 1
    rightCol.BorderSizePixel = 0
    rightCol.Position = UDim2.new(0.5, columnGap / 2, 0, 0)
    rightCol.Size = UDim2.new(0.5, -columnGap / 2, 1, 0)
    rightCol.CanvasSize = UDim2.new(0, 0, 0, 0)
    rightCol.AutomaticCanvasSize = Enum.AutomaticSize.Y
    rightCol.ScrollBarThickness = 3
    rightCol.ScrollBarImageColor3 = Theme.Accent
    rightCol.Parent = parentFrame

    for _, col in ipairs({ leftCol, rightCol }) do
        local l = Instance.new("UIListLayout")
        l.SortOrder = Enum.SortOrder.LayoutOrder
        l.Padding = UDim.new(0, 16)
        l.Parent = col
    end

    local categoryCount = 0
    local function updateSingleCategoryLayout()
        if categoryCount <= 1 then
            leftCol.Size = UDim2.new(1, 0, 1, 0)
            rightCol.Visible = false
        else
            leftCol.Size = UDim2.new(0.5, -columnGap / 2, 1, 0)
            rightCol.Visible = true
        end
    end
    updateSingleCategoryLayout()

    local leftHeight, rightHeight = 0, 0
    local categoryLayoutOrder = 0

    function pageApi.new(catOptions)
        categoryCount = categoryCount + 1
        updateSingleCategoryLayout()

        local targetCol = (leftHeight <= rightHeight) and leftCol or rightCol
        local category = NewCategory(targetCol, catOptions, registerFlag)

        categoryLayoutOrder = categoryLayoutOrder + 1
        category.Instance.LayoutOrder = categoryLayoutOrder

        local lastKnownHeight = 40
        if targetCol == leftCol then leftHeight = leftHeight + lastKnownHeight
        else rightHeight = rightHeight + lastKnownHeight end

        category.Instance:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            local newHeight = category.Instance.AbsoluteSize.Y
            local delta = newHeight - lastKnownHeight
            lastKnownHeight = newHeight
            if targetCol == leftCol then leftHeight = leftHeight + delta
            else rightHeight = rightHeight + delta end
        end)

        return category
    end

    pageApi.Instance = parentFrame
    return pageApi
end

