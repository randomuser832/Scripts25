------------------------------------------------------------------
-- Utilities
------------------------------------------------------------------

local Signal = {}
Signal.__index = Signal
function Signal.new() return setmetatable({ _h = {} }, Signal) end
function Signal:Connect(fn)
    local h = self._h
    local c = { Connected = true }
    h[c] = fn
    function c:Disconnect() self.Connected = false; h[self] = nil end
    return c
end
function Signal:Fire(...)
    for c, fn in pairs(self._h) do
        if c.Connected then task.spawn(fn, ...) end
    end
end

local function Tween(inst, props, dur, style, dir)
    local tw = TweenService:Create(inst, TweenInfo.new(dur or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function Round(inst, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 6)
    c.Parent = inst
    return c
end

local function Stroke(inst, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.new(1, 1, 1)
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.88
    s.Parent = inst
    return s
end

local function Pad(inst, l, t, r, b)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, l or 0)
    p.PaddingTop = UDim.new(0, t or l or 0)
    p.PaddingRight = UDim.new(0, r or l or 0)
    p.PaddingBottom = UDim.new(0, b or t or l or 0)
    p.Parent = inst
    return p
end

local function MakeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    conn:Disconnect()
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

local topZ = 10
local function BringToFront(frame)
    topZ = topZ + 1
    frame.ZIndex = topZ
end

------------------------------------------------------------------
-- Element factory — populates a category's body with rows
------------------------------------------------------------------

local function NewElementFactory(container, onSizeChanged, registerFlag)
    local factory = {}

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    layout.Parent = container

    if onSizeChanged then
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(onSizeChanged)
    end

    local nextOrder = 0
    local function claimOrder(inst)
        nextOrder = nextOrder + 1
        inst.LayoutOrder = nextOrder
    end

    ------------------------------------------------------------------
    function factory.Toggle(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new()
        api.Value = not not opts.default

        local row = Instance.new("Frame")
        row.BackgroundTransparency = 1
        row.Size = UDim2.new(1, 0, 0, 20)
        row.Parent = container
        claimOrder(row)

        local box = Instance.new("Frame")
        box.Size = UDim2.new(0, 16, 0, 16)
        box.Position = UDim2.new(0, 0, 0.5, -8)
        box.BackgroundColor3 = Theme.PanelLight
        box.Parent = row
        Round(box, 4)
        Stroke(box, Color3.new(1, 1, 1), 1, 0.8)

        local check = Instance.new("TextLabel")
        check.BackgroundTransparency = 1
        check.Size = UDim2.new(1, 0, 1, 0)
        check.Font = Theme.FontBold
        check.TextSize = 12
        check.TextColor3 = Theme.Accent
        check.Text = "✓"
        check.TextTransparency = api.Value and 0 or 1
        check.Parent = box

        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Position = UDim2.new(0, 26, 0, 0)
        label.Size = UDim2.new(1, -26, 1, 0)
        label.Font = Theme.Font
        label.TextSize = 14
        label.TextColor3 = Theme.SubText
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Text = opts.text or "Toggle"
        label.Parent = row

        local clickArea = Instance.new("TextButton")
        clickArea.BackgroundTransparency = 1
        clickArea.Size = UDim2.new(1, 0, 1, 0)
        clickArea.Text = ""
        clickArea.Parent = row

        local function render()
            Tween(check, { TextTransparency = api.Value and 0 or 1 }, 0.1)
            Tween(box, { BackgroundColor3 = api.Value and Theme.Accent or Theme.PanelLight }, 0.1)
            Tween(check, { TextColor3 = api.Value and Color3.new(1, 1, 1) or Theme.Accent }, 0.1)
            Tween(label, { TextColor3 = api.Value and Theme.Text or Theme.SubText }, 0.1)
        end

        function api.Set(v, silent)
            v = not not v
            if v == api.Value then return end
            api.Value = v
            render()
            if not silent then api.Event:Fire(api.Value) end
        end

        clickArea.MouseButton1Click:Connect(function() api.Set(not api.Value) end)
        render()

        if opts.flag and registerFlag then
            registerFlag(opts.flag, function() return api.Value end, function(v) api.Set(v, true) end)
        end

        api.Instance = row
        function api.Destroy() row:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    function factory.KeybindToggle(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new()
        api.BindEvent = Signal.new()
        api.Value = not not opts.default
        api.Bind = opts.defaultBind or "None"

        local toggle = factory.Toggle({ text = opts.text, default = opts.default })
        api.ToggleValue = toggle.Value
        toggle.Event:Connect(function(v) api.Event:Fire(v) end)

        local bindBtn = Instance.new("TextButton")
        bindBtn.AnchorPoint = Vector2.new(1, 0.5)
        bindBtn.Position = UDim2.new(1, 0, 0.5, 0)
        bindBtn.Size = UDim2.new(0, 60, 1, 0)
        bindBtn.BackgroundTransparency = 1
        bindBtn.Font = Theme.Font
        bindBtn.TextSize = 13
        bindBtn.TextColor3 = Theme.SubText
        bindBtn.Text = api.Bind
        bindBtn.TextXAlignment = Enum.TextXAlignment.Right
        bindBtn.Parent = toggle.Instance

        local listening = false
        bindBtn.MouseButton1Click:Connect(function()
            if listening then return end
            listening = true
            bindBtn.Text = "..."
            local conn
            conn = UserInputService.InputBegan:Connect(function(input, gpe)
                if gpe then return end
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    api.Bind = input.KeyCode.Name
                    bindBtn.Text = api.Bind
                    listening = false
                    conn:Disconnect()
                    api.BindEvent:Fire(api.Bind)
                end
            end)
        end)

        function api.Set(v, silent) toggle.Set(v, silent) end
        function api.SetBind(name) api.Bind = name; bindBtn.Text = name end

        api.Instance = toggle.Instance
        function api.Destroy() toggle.Destroy() end
        return api
    end

    ------------------------------------------------------------------
    function factory.Label(opts)
        opts = opts or {}
        local lbl = Instance.new("TextLabel")
        lbl.BackgroundTransparency = 1
        lbl.Size = UDim2.new(1, 0, 0, 18)
        lbl.Font = Theme.Font
        lbl.TextSize = 13
        lbl.TextColor3 = opts.color or Theme.SubText
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Text = opts.text or ""
        lbl.Parent = container
        claimOrder(lbl)

        local api = { Instance = lbl }
        function api.SetText(t) lbl.Text = t end
        function api.Destroy() lbl:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    function factory.TextBox(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new()
        api.Text = ""

        local box = Instance.new("TextBox")
        box.BackgroundColor3 = Theme.PanelLight
        box.Size = UDim2.new(1, 0, 0, 34)
        box.Font = Theme.Font
        box.TextSize = 14
        box.TextColor3 = Theme.Text
        box.PlaceholderText = opts.placeholder or "Enter value"
        box.PlaceholderColor3 = Theme.SubText
        box.Text = ""
        box.ClearTextOnFocus = false
        box.Parent = container
        claimOrder(box)
        Round(box, 6)
        Stroke(box)
        Pad(box, 10)

        box:GetPropertyChangedSignal("Text"):Connect(function() api.Text = box.Text end)
        box.FocusLost:Connect(function(enterPressed)
            if enterPressed then api.Event:Fire(box.Text) end
        end)

        function api.Get() return box.Text end
        function api.Set(text) box.Text = text end

        if opts.flag and registerFlag then
            registerFlag(opts.flag, api.Get, api.Set)
        end

        api.Instance = box
        function api.Destroy() box:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    function factory.Button(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new()

        local btn = Instance.new("TextButton")
        btn.AutoButtonColor = false
        btn.BackgroundColor3 = Theme.PanelLight
        btn.Size = UDim2.new(1, 0, 0, 34)
        btn.Font = Theme.Font
        btn.TextSize = 14
        btn.TextColor3 = Theme.SubText
        btn.Text = opts.text or "Button"
        btn.Parent = container
        claimOrder(btn)
        Round(btn, 6)
        Stroke(btn)

        btn.MouseEnter:Connect(function() Tween(btn, { BackgroundColor3 = Theme.Accent, TextColor3 = Color3.new(1,1,1) }, 0.12) end)
        btn.MouseLeave:Connect(function() Tween(btn, { BackgroundColor3 = Theme.PanelLight, TextColor3 = Theme.SubText }, 0.12) end)
        btn.MouseButton1Click:Connect(function() api.Event:Fire() end)

        function api.SetText(t) btn.Text = t end
        api.Instance = btn
        function api.Destroy() btn:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    function factory.Slider(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new()

        local min = opts.min or 0
        local max = opts.max or 100
        local suffix = opts.suffix or ""
        api.Value = math.clamp(opts.default or min, min, max)

        local holder = Instance.new("Frame")
        holder.BackgroundTransparency = 1
        holder.Size = UDim2.new(1, 0, 0, 36)
        holder.Parent = container
        claimOrder(holder)

        local topRow = Instance.new("Frame")
        topRow.BackgroundTransparency = 1
        topRow.Size = UDim2.new(1, 0, 0, 16)
        topRow.Parent = holder

        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, -60, 1, 0)
        label.Font = Theme.Font
        label.TextSize = 13
        label.TextColor3 = Theme.SubText
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Text = opts.text or "Slider"
        label.Parent = topRow

        local valueLabel = Instance.new("TextLabel")
        valueLabel.BackgroundTransparency = 1
        valueLabel.AnchorPoint = Vector2.new(1, 0)
        valueLabel.Position = UDim2.new(1, 0, 0, 0)
        valueLabel.Size = UDim2.new(0, 60, 1, 0)
        valueLabel.Font = Theme.Font
        valueLabel.TextSize = 13
        valueLabel.TextColor3 = Theme.Text
        valueLabel.TextXAlignment = Enum.TextXAlignment.Right
        valueLabel.Parent = topRow

        local track = Instance.new("Frame")
        track.Position = UDim2.new(0, 0, 0, 22)
        track.Size = UDim2.new(1, 0, 0, 6)
        track.BackgroundColor3 = Theme.PanelLight
        track.Parent = holder
        Round(track, 3)

        local fill = Instance.new("Frame")
        fill.BackgroundColor3 = opts.color or Theme.Accent
        fill.Size = UDim2.new(0, 0, 1, 0)
        fill.Parent = track
        Round(fill, 3)

        local knob = Instance.new("Frame")
        knob.AnchorPoint = Vector2.new(0.5, 0.5)
        knob.Size = UDim2.new(0, 12, 0, 12)
        knob.Position = UDim2.new(0, 0, 0.5, 0)
        knob.BackgroundColor3 = Color3.new(1, 1, 1)
        knob.ZIndex = 2
        knob.Parent = track
        Round(knob, 6)

        local function render()
            local alpha = (api.Value - min) / (max - min)
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            knob.Position = UDim2.new(alpha, 0, 0.5, 0)
            if suffix == "%" then
                valueLabel.Text = tostring(math.floor(alpha * 100 + 0.5)) .. "%"
            else
                valueLabel.Text = tostring(math.floor(api.Value + 0.5)) .. suffix
            end
        end

        function api.Set(v, silent)
            v = math.clamp(v, min, max)
            api.Value = v
            render()
            if not silent then api.Event:Fire(api.Value) end
        end
        render()

        local dragging = false
        local function updateFromInput(input)
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            api.Set(min + rel * (max - min))
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                updateFromInput(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateFromInput(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        if opts.flag and registerFlag then
            registerFlag(opts.flag, function() return api.Value end, function(v) api.Set(v, true) end)
        end

        api.Instance = holder
        function api.Destroy() holder:Destroy() end
        return api
    end

