-- Window
------------------------------------------------------------------

local Library = {}

function Library.new(options)
    options = options or {}
    local api = {}

    local sizeX = options.width or 720
    local sizeY = options.height or 480

    ------------------------------------------------------------------
    -- Config save/load: any element created with an opts.flag registers
    -- a getter/setter here, so SaveConfig/LoadConfig can capture or
    -- restore the whole UI's state (every toggle, slider, dropdown,
    -- textbox, and keybind you gave a flag to) in one call. Uses
    -- writefile/readfile (present in script executors) — everything is
    -- pcall-guarded so the UI still works fine in environments that
    -- don't have them (e.g. Roblox Studio), just without persistence.
    ------------------------------------------------------------------
    local flagRegistry = {}
    local function registerFlag(flag, getter, setter)
        if not flag then return end
        flagRegistry[flag] = { get = getter, set = setter }
    end

    local CONFIG_FOLDER = options.configFolder or "SebsUI"

    local function ensureConfigFolder()
        pcall(function()
            if isfolder and makefolder and not isfolder(CONFIG_FOLDER) then
                makefolder(CONFIG_FOLDER)
            end
        end)
    end

    -- Captures the CURRENT state of every flagged element (whatever's
    -- toggled on, every slider value, every dropdown selection, every
    -- textbox and keybind) and writes it to <CONFIG_FOLDER>/<name>.json.
    function api.SaveConfig(name)
        if not (writefile and HttpService) or not name or name == "" then return false end
        local data = {}
        for flag, entry in pairs(flagRegistry) do
            local ok, value = pcall(entry.get)
            if ok then data[flag] = value end
        end
        local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
        if not ok then return false end
        ensureConfigFolder()
        local writeOk = pcall(function()
            writefile(CONFIG_FOLDER .. "/" .. name .. ".json", encoded)
        end)
        return writeOk
    end

    function api.LoadConfig(name)
        if not (readfile and HttpService) or not name or name == "" then return false end
        local ok, content = pcall(function() return readfile(CONFIG_FOLDER .. "/" .. name .. ".json") end)
        if not ok then return false end
        local decodeOk, data = pcall(function() return HttpService:JSONDecode(content) end)
        if not decodeOk or type(data) ~= "table" then return false end
        for flag, value in pairs(data) do
            local entry = flagRegistry[flag]
            if entry then pcall(entry.set, value) end
        end
        return true
    end

    function api.DeleteConfig(name)
        if not (delfile and isfile) or not name or name == "" then return false end
        return pcall(function()
            if isfile(CONFIG_FOLDER .. "/" .. name .. ".json") then
                delfile(CONFIG_FOLDER .. "/" .. name .. ".json")
            end
        end)
    end

    function api.ListConfigs()
        if not listfiles then return {} end
        local ok, files = pcall(listfiles, CONFIG_FOLDER)
        if not ok then return {} end
        local names = {}
        for _, path in ipairs(files) do
            local name = tostring(path):match("([^/\\]+)%.json$")
            if name then table.insert(names, name) end
        end
        return names
    end

    -- outer glow wrapper — a CanvasGroup (not a plain Frame) specifically
    -- so the whole window can be faded in/out as ONE unit via its single
    -- GroupTransparency property (see api.Open/Close/Toggle near the
    -- bottom), which is what actually makes the Settings tab's "Fade
    -- Time" slider do something instead of sitting there unused.
    local glow = Instance.new("CanvasGroup")
    glow.BackgroundTransparency = 1
    glow.GroupTransparency = 0
    glow.Size = UDim2.new(0, sizeX, 0, sizeY)
    glow.Position = options.position or UDim2.new(0.5, -sizeX / 2, 0.5, -sizeY / 2)
    glow.Parent = ScreenGui
    local windowVisible = true

    local window = Instance.new("Frame")
    window.Active = true
    window.BackgroundColor3 = Theme.Background
    window.Size = UDim2.new(1, 0, 1, 0)
    window.ClipsDescendants = true
    window.Parent = glow
    Round(window, 12)
    Stroke(window, Theme.Accent, 1.5, 0.35)

    ------------------------------------------------------------------
    -- Loading screen: a brief splash over the window while everything
    -- settles, then it fades itself out. Purely cosmetic — nothing here
    -- blocks or delays the actual UI underneath from being ready.
    ------------------------------------------------------------------
    do
        local loadingScreen = Instance.new("Frame")
        loadingScreen.BackgroundColor3 = Theme.Background
        loadingScreen.Size = UDim2.new(1, 0, 1, 0)
        loadingScreen.ZIndex = 50
        loadingScreen.Parent = window
        Round(loadingScreen, 12)

        local loadingLogo = Instance.new("Frame")
        loadingLogo.AnchorPoint = Vector2.new(0.5, 0.5)
        loadingLogo.Position = UDim2.new(0.5, 0, 0.5, -24)
        loadingLogo.Size = UDim2.new(0, 56, 0, 56)
        loadingLogo.BackgroundColor3 = Theme.Accent
        loadingLogo.ZIndex = 51
        loadingLogo.Parent = loadingScreen
        Round(loadingLogo, 14)
        BuildLogoContent(loadingLogo, options.logo, options.title, 26)
        for _, child in ipairs(loadingLogo:GetChildren()) do
            if child:IsA("GuiObject") then child.ZIndex = 51 end
        end

        local loadingText = Instance.new("TextLabel")
        loadingText.AnchorPoint = Vector2.new(0.5, 0)
        loadingText.Position = UDim2.new(0.5, 0, 0.5, 16)
        loadingText.Size = UDim2.new(0, 260, 0, 20)
        loadingText.BackgroundTransparency = 1
        loadingText.Font = Theme.Font
        loadingText.TextSize = 14
        loadingText.TextColor3 = Theme.SubText
        loadingText.Text = "Loading " .. (options.title or "Seb's UI") .. "..."
        loadingText.ZIndex = 51
        loadingText.Parent = loadingScreen

        local barTrack = Instance.new("Frame")
        barTrack.AnchorPoint = Vector2.new(0.5, 0)
        barTrack.Position = UDim2.new(0.5, 0, 0.5, 44)
        barTrack.Size = UDim2.new(0, 160, 0, 4)
        barTrack.BackgroundColor3 = Theme.PanelLight
        barTrack.ZIndex = 51
        barTrack.Parent = loadingScreen
        Round(barTrack, 2)

        local barFill = Instance.new("Frame")
        barFill.BackgroundColor3 = Theme.Accent
        barFill.Size = UDim2.new(0, 0, 1, 0)
        barFill.ZIndex = 52
        barFill.Parent = barTrack
        Round(barFill, 2)

        Tween(barFill, { Size = UDim2.new(1, 0, 1, 0) }, 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

        print(("[%s] Loading..."):format(options.title or "Seb's UI"))

        task.delay(0.7, function()
            Tween(loadingScreen, { BackgroundTransparency = 1 }, 0.3)
            for _, d in ipairs(loadingScreen:GetDescendants()) do
                if d:IsA("TextLabel") then Tween(d, { TextTransparency = 1 }, 0.3) end
                if d:IsA("Frame") then Tween(d, { BackgroundTransparency = 1 }, 0.3) end
                if d:IsA("ImageLabel") then Tween(d, { ImageTransparency = 1 }, 0.3) end
            end
            task.wait(0.3)
            loadingScreen:Destroy()
            print(("[%s] Loaded."):format(options.title or "Seb's UI"))
        end)
    end

    ------------------------------------------------------------------
    -- Header (logo + title/subtitle on the left, tab icons + avatar on
    -- the right, all in one row — the tab bar lives in the topbar now,
    -- right after the script's title/subtitle)
    ------------------------------------------------------------------
    local header = Instance.new("Frame")
    header.Active = true
    header.BackgroundColor3 = Theme.Header
    header.Size = UDim2.new(1, 0, 0, 68)
    header.Parent = window

    -- Logo: shows a custom image if options.logo is set (an rbxassetid://
    -- string, or a numeric asset id — either works, see BuildLogoContent),
    -- otherwise falls back to the first letter of the title, same as
    -- before. Changeable at runtime with window.SetLogo(...).
    local currentLogo = options.logo

    local logo = Instance.new("Frame")
    logo.Position = UDim2.new(0, 16, 0.5, -18)
    logo.Size = UDim2.new(0, 36, 0, 36)
    logo.BackgroundColor3 = Theme.Accent
    logo.Parent = header
    Round(logo, 8)
    BuildLogoContent(logo, currentLogo, options.title, 18)

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Position = UDim2.new(0, 62, 0, 12)
    titleLabel.Size = UDim2.new(0, 220, 0, 22)
    titleLabel.Font = Theme.FontBold
    titleLabel.TextSize = 17
    titleLabel.TextColor3 = Theme.Text
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Text = options.title or "Seb's UI"
    titleLabel.Parent = header

    local subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Position = UDim2.new(0, 62, 0, 34)
    subtitleLabel.Size = UDim2.new(0, 220, 0, 16)
    subtitleLabel.Font = Theme.Font
    subtitleLabel.TextSize = 12
    subtitleLabel.TextColor3 = Theme.SubText
    subtitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    subtitleLabel.Text = options.subtitle or ""
    subtitleLabel.Parent = header

    -- right-hand group: tab icon row, then the avatar chip, right-aligned
    -- and vertically centered in the header
    local rightGroup = Instance.new("Frame")
    rightGroup.BackgroundTransparency = 1
    rightGroup.AnchorPoint = Vector2.new(1, 0.5)
    rightGroup.Position = UDim2.new(1, -16, 0.5, 0)
    rightGroup.AutomaticSize = Enum.AutomaticSize.X
    rightGroup.Size = UDim2.new(0, 0, 0, 40)
    rightGroup.Parent = header

    local rightGroupLayout = Instance.new("UIListLayout")
    rightGroupLayout.FillDirection = Enum.FillDirection.Horizontal
    rightGroupLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    rightGroupLayout.Padding = UDim.new(0, 12)
    rightGroupLayout.SortOrder = Enum.SortOrder.LayoutOrder
    rightGroupLayout.Parent = rightGroup

    local tabBar = Instance.new("Frame")
    tabBar.BackgroundTransparency = 1
    tabBar.AutomaticSize = Enum.AutomaticSize.X
    tabBar.Size = UDim2.new(0, 0, 0, 36)
    tabBar.LayoutOrder = 1
    tabBar.Parent = rightGroup

    local tabBarLayout = Instance.new("UIListLayout")
    tabBarLayout.FillDirection = Enum.FillDirection.Horizontal
    tabBarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabBarLayout.Padding = UDim.new(0, 8)
    tabBarLayout.Parent = tabBar

    local userChip = Instance.new("Frame")
    userChip.Size = UDim2.new(0, 40, 0, 40)
    userChip.LayoutOrder = 2
    userChip.BackgroundColor3 = Theme.PanelLight
    userChip.Parent = rightGroup
    Round(userChip, 20)
    Stroke(userChip)

    local avatarImage = Instance.new("ImageLabel")
    avatarImage.BackgroundTransparency = 1
    avatarImage.Size = UDim2.new(1, -4, 1, -4)
    avatarImage.Position = UDim2.new(0, 2, 0, 2)
    avatarImage.Parent = userChip
    Round(avatarImage, 18)

    local function setAvatar()
        if not LocalPlayer then return end
        local ok, content = pcall(function()
            return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
        end)
        if ok then avatarImage.Image = content end
    end
    task.spawn(setAvatar)

    MakeDraggable(window, header)
    window.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            BringToFront(glow)
        end
    end)

    ------------------------------------------------------------------
    -- Pages container: one page per tab, each its own two-column
    -- category layout (built with BuildCategoryPage above). Sits right
    -- below the header now that the tab icons moved into the topbar.
    ------------------------------------------------------------------
    local pagesContainer = Instance.new("Frame")
    pagesContainer.BackgroundTransparency = 1
    pagesContainer.Position = UDim2.new(0, 16, 0, 84)
    pagesContainer.Size = UDim2.new(1, -32, 1, -100)
    pagesContainer.Parent = window

    local tabs = {}
    local selectedTab = nil

    local function selectTab(id)
        selectedTab = id
        for _, t in ipairs(tabs) do
            local isSelected = (t.id == id)
            t.page.Visible = isSelected
            Tween(t.button, {
                BackgroundColor3 = isSelected and Theme.Accent or Theme.PanelLight,
                TextColor3 = isSelected and Color3.new(1, 1, 1) or Theme.SubText,
            }, 0.1)
        end
    end

    -- Create a new tab. opts.icon is a single glyph/emoji shown as a small
    -- square icon button in the topbar (e.g. "👤" or "⚙"), opts.name is
    -- used for the tooltip-ish text inside longer tab buttons if you pass
    -- opts.wide = true.
    function api.Tab(opts)
        opts = opts or {}

        local page = Instance.new("Frame")
        page.BackgroundTransparency = 1
        page.Size = UDim2.new(1, 0, 1, 0)
        page.Visible = false
        page.Parent = pagesContainer

        local btn = Instance.new("TextButton")
        btn.AutoButtonColor = false
        btn.BackgroundColor3 = Theme.PanelLight
        btn.Size = opts.wide and UDim2.new(0, 120, 0, 36) or UDim2.new(0, 36, 0, 36)
        btn.Font = Theme.FontBold
        btn.TextSize = 16
        btn.TextColor3 = Theme.SubText
        btn.Text = opts.wide and ((opts.icon and (opts.icon .. "  ") or "") .. (opts.name or "Tab")) or (opts.icon or "•")
        btn.Parent = tabBar
        Round(btn, 10)

        local id = #tabs + 1
        local pageApi = BuildCategoryPage(page, registerFlag)
        tabs[id] = { id = id, page = page, button = btn, pageApi = pageApi }
        btn.MouseButton1Click:Connect(function() selectTab(id) end)

        local tabApi = { new = pageApi.new, Instance = page, Button = btn }

        if id == 1 then selectTab(id) end
        return tabApi
    end

    -- Fallback for simple, tab-less usage: window.new(...) works exactly like
    -- before by silently creating a single default tab the first time it's called.
    function api.new(catOptions)
        if not tabs[1] then api.Tab({ icon = "≡" }) end
        return tabs[1].pageApi.new(catOptions)
    end

    ------------------------------------------------------------------
    -- Notifications: theme-matched toast cards that slide in from the
    -- corner, stack, and auto-dismiss. Position defaults to top-right;
    -- api.SetNotificationPosition("TopLeft"/"TopRight") flips it — this
    -- is exposed through SettingsTab below so the user can change it,
    -- and it's flag-registered so it saves/loads with configs too.
    ------------------------------------------------------------------
    local notifPosition = "TopRight"

    local notifContainer = Instance.new("Frame")
    notifContainer.BackgroundTransparency = 1
    notifContainer.Size = UDim2.new(0, 280, 1, -32)
    notifContainer.ZIndex = 1000
    notifContainer.Parent = ScreenGui

    local notifLayout = Instance.new("UIListLayout")
    notifLayout.SortOrder = Enum.SortOrder.LayoutOrder
    notifLayout.Padding = UDim.new(0, 8)
    notifLayout.Parent = notifContainer

    local function applyNotifPosition()
        if notifPosition == "TopLeft" then
            notifContainer.AnchorPoint = Vector2.new(0, 0)
            notifContainer.Position = UDim2.new(0, 16, 0, 16)
            notifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
        else
            notifContainer.AnchorPoint = Vector2.new(1, 0)
            notifContainer.Position = UDim2.new(1, -16, 0, 16)
            notifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        end
    end
    applyNotifPosition()

    function api.SetNotificationPosition(pos)
        notifPosition = (pos == "TopLeft") and "TopLeft" or "TopRight"
        applyNotifPosition()
    end
    function api.GetNotificationPosition()
        return notifPosition
    end

    -- Switches the whole UI's color scheme live. name must be one of
    -- ThemeOrder ("Purple", "Crimson", "Ocean", "Emerald", "Amber",
    -- "Monochrome", "Rainbow"). Everything already on screen repaints
    -- immediately; anything created afterward matches automatically.
    function api.SetTheme(name)
        applyThemeByName(name)
    end
    function api.GetThemeName()
        return currentThemeName
    end

    -- api.Notify("just a message") or
    -- api.Notify({ title = "Saved", text = "Config saved.", duration = 4 })
    function api.Notify(opts)
        if type(opts) == "string" then opts = { text = opts } end
        opts = opts or {}
        local duration = opts.duration or 4

        -- the slot participates in the container's UIListLayout (so cards
        -- stack correctly); the card inside it is free to animate its own
        -- Position for the slide effect without the layout fighting it
        local slot = Instance.new("Frame")
        slot.BackgroundTransparency = 1
        slot.Size = UDim2.new(1, 0, 0, 0)
        slot.AutomaticSize = Enum.AutomaticSize.Y
        slot.ZIndex = 1000
        slot.Parent = notifContainer

        local offscreenX = (notifPosition == "TopLeft") and -300 or 300

        local card = Instance.new("Frame")
        card.BackgroundColor3 = Theme.Panel
        card.Size = UDim2.new(1, 0, 0, 0)
        card.AutomaticSize = Enum.AutomaticSize.Y
        card.Position = UDim2.new(0, offscreenX, 0, 0)
        card.ClipsDescendants = true
        card.ZIndex = 1001
        card.Parent = slot
        Round(card, 8)
        Stroke(card, Theme.Accent, 1, 0.4)

        local accent = Instance.new("Frame")
        accent.BackgroundColor3 = Theme.Accent
        accent.Size = UDim2.new(0, 3, 1, -12)
        accent.Position = UDim2.new(0, 0, 0, 6)
        accent.ZIndex = 1002
        accent.Parent = card
        Round(accent, 2)

        local inner = Instance.new("Frame")
        inner.BackgroundTransparency = 1
        inner.Position = UDim2.new(0, 16, 0, 0)
        inner.Size = UDim2.new(1, -26, 0, 0)
        inner.AutomaticSize = Enum.AutomaticSize.Y
        inner.ZIndex = 1002
        inner.Parent = card
        Pad(inner, 0, 10, 0, 10)

        local innerLayout = Instance.new("UIListLayout")
        innerLayout.SortOrder = Enum.SortOrder.LayoutOrder
        innerLayout.Padding = UDim.new(0, 2)
        innerLayout.Parent = inner

        if opts.title then
            local titleLbl = Instance.new("TextLabel")
            titleLbl.BackgroundTransparency = 1
            titleLbl.Size = UDim2.new(1, 0, 0, 18)
            titleLbl.Font = Theme.FontBold
            titleLbl.TextSize = 14
            titleLbl.TextColor3 = Theme.Text
            titleLbl.TextXAlignment = Enum.TextXAlignment.Left
            titleLbl.ZIndex = 1002
            titleLbl.Text = opts.title
            titleLbl.Parent = inner
        end

        local textLbl = Instance.new("TextLabel")
        textLbl.BackgroundTransparency = 1
        textLbl.Size = UDim2.new(1, 0, 0, 0)
        textLbl.AutomaticSize = Enum.AutomaticSize.Y
        textLbl.TextWrapped = true
        textLbl.Font = Theme.Font
        textLbl.TextSize = 13
        textLbl.TextColor3 = Theme.SubText
        textLbl.TextXAlignment = Enum.TextXAlignment.Left
        textLbl.ZIndex = 1002
        textLbl.Text = opts.text or ""
        textLbl.Parent = inner

        -- slide in
        Tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

        task.delay(duration, function()
            if not card.Parent then return end
            local tw = Tween(card, { Position = UDim2.new(0, offscreenX, 0, 0) }, 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            tw.Completed:Wait()
            if slot.Parent then slot:Destroy() end
        end)
    end

    ------------------------------------------------------------------
    -- Built-in Settings + Configs tab: menu keybind capture, unload
    -- button, fade/animation sliders, notification position, and a
    -- config selector wired to events you connect your own save/load
    -- logic to (the built-in save/load already runs by default).
    ------------------------------------------------------------------
    function api.SettingsTab(opts)
        opts = opts or {}
        local tab = api.Tab({ name = opts.name or "Settings", icon = opts.icon or "⚙" })

        local settingsCat = tab.new({ text = "Settings" })
        local keybind = settingsCat.Keybind({ text = "Menu Keybind", default = opts.keybind or "RightControl" })
        local unloadBtn = settingsCat.Button({ text = "Unload" })
        -- Both sliders show 0-100%, mapped onto a 0-1 second real range —
        -- e.g. 20% = 0.2s. They're fully wired: dragging them immediately
        -- changes how long the window's open/close fade takes, and how
        -- long every other animation in the library takes (toggles,
        -- sliders, dropdowns, press-flashes, category expand/collapse),
        -- not just cosmetic sliders that print a number nobody uses.
        local FADE_RANGE_SECONDS = 1
        local ANIM_RANGE_SECONDS = 1
        -- NOTE: these deliberately do NOT use Slider's own opts.flag — a
        -- config LOAD sets a flagged element silently (no .Event fire, by
        -- design, so loading a config doesn't spam your game logic), but
        -- these two sliders need the underlying global applied even on a
        -- silent load, so they're registered by hand exactly like the
        -- Theme dropdown above.
        local fadeSlider = settingsCat.Slider({
            text = "Fade Time", min = 0, max = 100,
            default = math.clamp(math.floor((opts.fadeTime or 0.2) / FADE_RANGE_SECONDS * 100 + 0.5), 0, 100),
            suffix = "%",
        })
        local animSlider = settingsCat.Slider({
            text = "Animation Speed", min = 0, max = 100,
            default = math.clamp(math.floor((opts.animationSpeed or 0.25) / ANIM_RANGE_SECONDS * 100 + 0.5), 0, 100),
            suffix = "%",
        })
        SetGlobalFadeTime(fadeSlider.Value / 100 * FADE_RANGE_SECONDS)
        SetGlobalAnimSpeed(animSlider.Value / 100 * ANIM_RANGE_SECONDS)
        fadeSlider.Event:Connect(function(value) SetGlobalFadeTime(value / 100 * FADE_RANGE_SECONDS) end)
        animSlider.Event:Connect(function(value) SetGlobalAnimSpeed(value / 100 * ANIM_RANGE_SECONDS) end)
        registerFlag("FadeTime", function() return fadeSlider.Value end, function(v)
            fadeSlider.Set(v, true)
            SetGlobalFadeTime(v / 100 * FADE_RANGE_SECONDS)
        end)
        registerFlag("AnimationSpeed", function() return animSlider.Value end, function(v)
            animSlider.Set(v, true)
            SetGlobalAnimSpeed(v / 100 * ANIM_RANGE_SECONDS)
        end)
        local notifPosDropdown = settingsCat.Dropdown({
            text = "Notification Position",
            options = { "TopRight", "TopLeft" },
            default = notifPosition,
            flag = "NotificationPosition",
        })
        notifPosDropdown.Event:Connect(function(value) api.SetNotificationPosition(value) end)

        -- Theme dropdown — repaints the whole UI live. Uses a custom flag
        -- registration (rather than Dropdown's built-in `flag` option)
        -- because loading a config needs to actually REPAINT the UI, not
        -- just silently update what the dropdown displays.
        local themeDropdown = settingsCat.Dropdown({
            text = "Theme",
            options = ThemeOrder,
            default = currentThemeName,
        })
        themeDropdown.Event:Connect(function(value) api.SetTheme(value) end)
        registerFlag("Theme", function() return themeDropdown.Value end, function(value)
            themeDropdown.Set(value, true)
            api.SetTheme(value)
        end)

        local configsCat = tab.new({ text = "Configs" })
        local configDropdown = configsCat.Dropdown({ options = opts.configs or {}, placeholder = "..." })
        local nameBox = configsCat.TextBox({ placeholder = "Config name" })
        local createBtn = configsCat.Button({ text = "Create" })
        local loadBtn = configsCat.Button({ text = "Load" })
        local saveBtn = configsCat.Button({ text = "Save" })
        local deleteBtn = configsCat.Button({ text = "Delete" })
        local refreshBtn = configsCat.Button({ text = "Refresh" })

        local settingsApi = {}
        settingsApi.KeybindEvent = keybind.Event
        settingsApi.UnloadEvent = unloadBtn.Event
        settingsApi.FadeTimeEvent = fadeSlider.Event
        settingsApi.AnimationSpeedEvent = animSlider.Event
        settingsApi.NotificationPositionEvent = notifPosDropdown.Event
        settingsApi.ConfigCreateEvent = Signal.new()
        settingsApi.ConfigLoadEvent = Signal.new()
        settingsApi.ConfigSaveEvent = Signal.new()
        settingsApi.ConfigDeleteEvent = Signal.new()
        settingsApi.ConfigRefreshEvent = Signal.new()

        local function refreshDropdown()
            configDropdown.SetOptions(api.ListConfigs())
        end

        -- Create + Save both write every flagged element's CURRENT value
        -- (toggles, sliders, dropdowns, textboxes, keybinds — anything you
        -- gave an opts.flag, including what's actually turned on right
        -- now) to a config file. Create additionally picks up whatever
        -- name was typed in the box and adds it to the list.
        createBtn.Event:Connect(function()
            local name = nameBox.Get()
            settingsApi.ConfigCreateEvent:Fire(name)
            if name and name ~= "" then
                local ok = api.SaveConfig(name)
                refreshDropdown()
                configDropdown.Set(name)
                api.Notify({ title = "Config", text = ok and ("Created \"" .. name .. "\".") or "Couldn't save (no executor file access?)." })
            end
        end)
        local CONFIG_PLACEHOLDER = "..."
        local function hasValidSelection()
            local v = configDropdown.Value
            return v ~= nil and v ~= CONFIG_PLACEHOLDER
        end

        loadBtn.Event:Connect(function()
            settingsApi.ConfigLoadEvent:Fire(configDropdown.Value)
            if hasValidSelection() then
                local ok = api.LoadConfig(configDropdown.Value)
                api.Notify({ title = "Config", text = ok and ("Loaded \"" .. configDropdown.Value .. "\".") or "Couldn't load that config." })
            else
                api.Notify({ title = "Config", text = "Select a config first." })
            end
        end)
        saveBtn.Event:Connect(function()
            settingsApi.ConfigSaveEvent:Fire(configDropdown.Value)
            if hasValidSelection() then
                local ok = api.SaveConfig(configDropdown.Value)
                api.Notify({ title = "Config", text = ok and ("Saved \"" .. configDropdown.Value .. "\".") or "Couldn't save that config." })
            else
                api.Notify({ title = "Config", text = "Select a config first." })
            end
        end)
        deleteBtn.Event:Connect(function()
            settingsApi.ConfigDeleteEvent:Fire(configDropdown.Value)
            if hasValidSelection() then
                local deletedName = configDropdown.Value
                api.DeleteConfig(deletedName)
                refreshDropdown()
                configDropdown.Set(CONFIG_PLACEHOLDER, true) -- don't keep showing a name that no longer exists
                api.Notify({ title = "Config", text = "Deleted \"" .. deletedName .. "\"." })
            else
                api.Notify({ title = "Config", text = "Select a config first." })
            end
        end)
        refreshBtn.Event:Connect(function()
            settingsApi.ConfigRefreshEvent:Fire()
            refreshDropdown()
        end)
        refreshDropdown() -- populate with whatever configs already exist on disk

        -- sensible defaults: the menu keybind actually toggles the window,
        -- and Unload actually tears the UI down — override by disconnecting
        -- and reconnecting your own handlers if you want different behavior
        keybind.Event:Connect(function(key) api.SetMenuKeybind(key) end)
        unloadBtn.Event:Connect(function() api.Destroy() end)

        function settingsApi.SetConfigList(list) configDropdown.SetOptions(list) end
        settingsApi.Tab = tab
        settingsApi.MenuKeybind = keybind
        settingsApi.ConfigDropdown = configDropdown
        settingsApi.NotificationPositionDropdown = notifPosDropdown
        settingsApi.ThemeDropdown = themeDropdown
        return settingsApi
    end

    ------------------------------------------------------------------
    -- Menu keybind (defaults to RightControl) — toggles the whole window
    ------------------------------------------------------------------
    local menuKeyCode = Enum.KeyCode.RightControl
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == menuKeyCode then
            api.Toggle()
        end
    end)
    function api.SetMenuKeybind(keyCodeName)
        local ok, code = pcall(function() return Enum.KeyCode[keyCodeName] end)
        if ok and code then menuKeyCode = code end
    end

    -- Open/Close/Toggle fade the whole window in/out over GetGlobalFadeTime()
    -- seconds (live-controlled by the Settings tab's "Fade Time" slider,
    -- see SettingsTab above) instead of just snapping Visible on/off.
    function api.Open()
        if windowVisible then return end
        windowVisible = true
        glow.Visible = true
        glow.GroupTransparency = 1
        Tween(glow, { GroupTransparency = 0 }, GetGlobalFadeTime(), Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    end
    function api.Close()
        if not windowVisible then return end
        windowVisible = false
        local tw = Tween(glow, { GroupTransparency = 1 }, GetGlobalFadeTime(), Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        local conn
        conn = tw.Completed:Connect(function()
            if not windowVisible and glow.Parent then glow.Visible = false end
            conn:Disconnect()
        end)
    end
    function api.Toggle()
        if windowVisible then api.Close() else api.Open() end
    end
    function api.SetPosition(pos) glow.Position = pos end

    -- Swap the header logo for a custom image at any time — pass an
    -- rbxassetid:// string (or nil/"" to go back to the letter badge).
    function api.SetLogo(logoValue)
        currentLogo = logoValue
        BuildLogoContent(logo, currentLogo, options.title, 18)
    end
    function api.GetLogo() return currentLogo end

    function api.Destroy()
        stopRainbow()
        glow:Destroy()
        notifContainer:Destroy()
    end

    api.Instance = window
    return api
end

return Library
