------------------------------------------------------------------

local Library = {}

function Library.new(options)
    options = options or {}
    local api = {}

    local sizeX = options.width or 720
    local sizeY = options.height or 480

    local flagRegistry = {}
    local function registerFlag(flag, getter, setter)
        if not flag then return end
        flagRegistry[flag] = { get = getter, set = setter }
    end

    local CONFIG_FOLDER = options.configFolder or "SebsUI"

    local function ensureConfigFolder()
        pcall(function()
            if isfolder and makefolder and not isfolder(CONFIG_FOLDER) then
                makefolder(CONFIG_FOLDER)
            end
        end)
    end

    function api.SaveConfig(name)
        if not (writefile and HttpService) or not name or name == "" then return false end
        local data = {}
        for flag, entry in pairs(flagRegistry) do
            local ok, value = pcall(entry.get)
            if ok then data[flag] = value end
        end
        local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
        if not ok then return false end
        ensureConfigFolder()
        local writeOk = pcall(function()
            writefile(CONFIG_FOLDER .. "/" .. name .. ".json", encoded)
        end)
        return writeOk
    end

    function api.LoadConfig(name)
        if not (readfile and HttpService) or not name or name == "" then return false end
        local ok, content = pcall(function() return readfile(CONFIG_FOLDER .. "/" .. name .. ".json") end)
        if not ok then return false end
        local decodeOk, data = pcall(function() return HttpService:JSONDecode(content) end)
        if not decodeOk or type(data) ~= "table" then return false end
        for flag, value in pairs(data) do
            local entry = flagRegistry[flag]
            if entry then pcall(entry.set, value) end
        end
        return true
    end

    function api.DeleteConfig(name)
        if not (delfile and isfile) or not name or name == "" then return false end
        return pcall(function()
            if isfile(CONFIG_FOLDER .. "/" .. name .. ".json") then
                delfile(CONFIG_FOLDER .. "/" .. name .. ".json")
            end
        end)
    end

    function api.ListConfigs()
        if not listfiles then return {} end
        local ok, files = pcall(listfiles, CONFIG_FOLDER)
        if not ok then return {} end
        local names = {}
        for _, path in ipairs(files) do
            local name = tostring(path):match("([^/\\]+)%.json$")
            if name then table.insert(names, name) end
        end
        return names
    end

