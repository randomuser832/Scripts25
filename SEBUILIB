-- Repaints every already-built instance under ScreenGui by matching its
-- CURRENT color against the OLD palette and swapping in the matching NEW
-- one. This is what makes switching themes affect everything already on
-- screen, without every single UI-building function in this file needing
-- to register itself with a theme system individually.
local function repaintExisting(oldPalette, newPalette)
    local swaps = {}
    for key, oldColor in pairs(oldPalette) do
        local newColor = newPalette[key]
        if newColor and typeof(oldColor) == "Color3" then
            table.insert(swaps, { oldColor, newColor })
        end
    end

    local function trySwap(color)
        for _, pair in ipairs(swaps) do
            if color == pair[1] then return pair[2] end
        end
        return nil
    end

    for _, inst in ipairs(ScreenGui:GetDescendants()) do
        local ok, bg = pcall(function() return inst.BackgroundColor3 end)
        if ok then
            local swapped = trySwap(bg)
            if swapped then inst.BackgroundColor3 = swapped end
        end
        if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
            local swapped = trySwap(inst.TextColor3)
            if swapped then inst.TextColor3 = swapped end
        end
        if inst:IsA("UIStroke") then
            local swapped = trySwap(inst.Color)
            if swapped then inst.Color = swapped end
        end
    end
end

local rainbowConn = nil
local function stopRainbow()
    if rainbowConn then rainbowConn:Disconnect(); rainbowConn = nil end
end

-- Cycles the accent color through the hue wheel continuously. Everything
-- else about the theme (backgrounds/panels/text) stays fixed — only the
-- accent (and the things currently painted with it) shifts color live.
local function startRainbow()
    stopRainbow()
    local hue = 0
    rainbowConn = RunService.Heartbeat:Connect(function(dt)
        hue = (hue + dt * 0.15) % 1
        local newAccent = Color3.fromHSV(hue, 0.85, 1)
        local newAccentDim = Color3.fromHSV(hue, 0.85, 0.65)
        local oldAccent, oldAccentDim = Theme.Accent, Theme.AccentDim
        Theme.Accent, Theme.AccentDim = newAccent, newAccentDim
        repaintExisting({ Accent = oldAccent, AccentDim = oldAccentDim }, { Accent = newAccent, AccentDim = newAccentDim })
    end)
end

-- Switches the whole UI to a different preset by name, repainting every
-- instance that already exists (see repaintExisting above) and updating
-- the live Theme table so anything created afterward matches too.
local function applyThemeByName(name)
    if not Themes[name] then return end
    stopRainbow()
    local oldTheme = {}
    for k, v in pairs(Theme) do
        if typeof(v) == "Color3" then oldTheme[k] = v end
    end
    for k, v in pairs(Themes[name]) do
        Theme[k] = v
    end
    repaintExisting(oldTheme, Themes[name])
    currentThemeName = name
    if name == "Rainbow" then startRainbow() end
end

------------------------------------------------------------------
-- Utilities
------------------------------------------------------------------

local Signal = {}
Signal.__index = Signal
function Signal.new() return setmetatable({ _h = {} }, Signal) end
function Signal:Connect(fn)
    local h = self._h
    local c = { Connected = true }
    h[c] = fn
    function c:Disconnect() self.Connected = false; h[self] = nil end
    return c
end
function Signal:Fire(...)
    for c, fn in pairs(self._h) do
        if c.Connected then task.spawn(fn, ...) end
    end
end

-- Global animation speed (seconds) — this is the DEFAULT duration used by
-- every Tween(...) call in the library that doesn't explicitly pass its
-- own `dur`. The Settings tab's "Animation Speed" slider actually drives
-- this value at runtime (see SettingsTab below) instead of just sitting
-- there for show, so turning it down genuinely snaps every toggle/slider/
-- dropdown/press-flash animation faster, and turning it up genuinely
-- slows all of them down.
local globalAnimSpeed = 0.15
local function SetGlobalAnimSpeed(v) globalAnimSpeed = math.clamp(v, 0.02, 1) end
local function GetGlobalAnimSpeed() return globalAnimSpeed end

-- Same idea for the window's open/close fade (see api.Open/Close/Toggle
-- near the bottom of Library.new) — the "Fade Time" slider drives this.
local globalFadeTime = 0.2
local function SetGlobalFadeTime(v) globalFadeTime = math.clamp(v, 0, 1.5) end
local function GetGlobalFadeTime() return globalFadeTime end

local function Tween(inst, props, dur, style, dir)
    local tw = TweenService:Create(inst, TweenInfo.new(dur or globalAnimSpeed, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function Round(inst, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 6)
    c.Parent = inst
    return c
end

local function Stroke(inst, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.new(1, 1, 1)
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.88
    s.Parent = inst
    return s
end

local function Pad(inst, l, t, r, b)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, l or 0)
    p.PaddingTop = UDim.new(0, t or l or 0)
    p.PaddingRight = UDim.new(0, r or l or 0)
    p.PaddingBottom = UDim.new(0, b or t or l or 0)
    p.Parent = inst
    return p
end

local function MakeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    conn:Disconnect()
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

local topZ = 10
local function BringToFront(frame)
    topZ = topZ + 1
    frame.ZIndex = topZ
end

-- Press-flash: replaces the old hover-brighten behavior everywhere it was
-- used. Instead of lighting up on MouseEnter/MouseLeave, a thin overlay
-- sits centered on the button at zero width and, the instant the button
-- is actually PRESSED (InputBegan — covers mouse AND touch, unlike
-- MouseButton1Down), tweens out from that centerline to both edges at
-- once while brightening, then shrinks back to the centerline and fades
-- when released. Visually: a brightness bar growing from the middle
-- outward to the sides, exactly on press/release, never on hover.
local function AddPressFlash(btn, opts)
    opts = opts or {}
    local flashColor = opts.color or Theme.Accent
    local pressedAlpha = opts.transparency or 0.55
    local pressedTextColor = opts.pressedTextColor or Color3.new(1, 1, 1)

    local overlay = Instance.new("Frame")
    overlay.Name = "PressFlash"
    overlay.AnchorPoint = Vector2.new(0.5, 0.5)
    overlay.Position = UDim2.new(0.5, 0, 0.5, 0)
    overlay.Size = UDim2.new(0, 0, 1, 0)
    overlay.BackgroundColor3 = flashColor
    overlay.BackgroundTransparency = 1
    overlay.BorderSizePixel = 0
    overlay.Parent = btn

    -- match the button's own rounding so the flash never pokes out past
    -- rounded corners
    local existingCorner = btn:FindFirstChildOfClass("UICorner")
    if existingCorner then
        local overlayCorner = Instance.new("UICorner")
        overlayCorner.CornerRadius = existingCorner.CornerRadius
        overlayCorner.Parent = overlay
    end

    -- Tracks the color the text/element should relax back to on release.
    -- Passed as a function (opts.getRestTextColor) when that color can
    -- change over time (e.g. a dropdown option's selected state), or a
    -- fixed color (opts.restTextColor) otherwise.
    local function restTextColor()
        if opts.getRestTextColor then return opts.getRestTextColor() end
        return opts.restTextColor or Theme.SubText
    end

    local function setPressed(isPressed)
        if isPressed then
            Tween(overlay, { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = pressedAlpha }, 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            if opts.animateText ~= false and btn:IsA("TextButton") then
                Tween(btn, { TextColor3 = pressedTextColor }, 0.1)
            end
        else
            Tween(overlay, { Size = UDim2.new(0, 0, 1, 0), BackgroundTransparency = 1 }, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            if opts.animateText ~= false and btn:IsA("TextButton") then
                Tween(btn, { TextColor3 = restTextColor() }, 0.2)
            end
        end
    end

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            setPressed(true)
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            setPressed(false)
        end
    end)

    return overlay
end

-- Builds (or rebuilds) the content of a logo square: a custom image if
-- one was provided, otherwise the first letter of the title. Used for
-- both the header logo and the loading-screen logo, and re-usable at
-- runtime by api.SetLogo so swapping the logo later doesn't require
-- rebuilding the whole header.
local function BuildLogoContent(container, logoValue, titleText, letterSize)
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("ImageLabel") or child:IsA("TextLabel") or child:IsA("UIPadding") then
            child:Destroy()
        end
    end
    if logoValue and logoValue ~= "" then
        Pad(container, 4) -- small inset so custom images read as a clean badge, not edge-to-edge
        local img = Instance.new("ImageLabel")
        img.BackgroundTransparency = 1
        img.Size = UDim2.new(1, 0, 1, 0)
        img.Image = logoValue
        img.ScaleType = Enum.ScaleType.Fit
        img.Parent = container
    else
        local letter = Instance.new("TextLabel")
        letter.BackgroundTransparency = 1
        letter.Size = UDim2.new(1, 0, 1, 0)
        letter.Font = Theme.FontBold
        letter.TextSize = letterSize or 18
        letter.TextColor3 = Color3.new(1, 1, 1)
        letter.Text = (titleText or "S"):sub(1, 1):upper()
        letter.Parent = container
    end
end

-- UserInputService:GetMouseLocation() returns the RAW screen position
-- (inset included), but GuiObject.AbsolutePosition is measured relative
-- to the area BELOW Roblox's top inset bar (inset excluded) unless the
-- ScreenGui has IgnoreGuiInset set. Comparing the two directly (as the
-- dropdown's click-away check does) is off by that inset amount — which
-- normally doesn't matter, but flips the boolean the wrong way for any
-- click landing within ~inset-height of a boundary, which is exactly
-- the kind of edge case a lower-positioned or flipped-open dropdown
-- panel is more likely to hit.
local function getInsetAdjustedMouse()
    local mouse = UserInputService:GetMouseLocation()
    local topLeftInset = GuiService:GetGuiInset()
    return mouse - topLeftInset
end

-- Only one dropdown's floating panel should ever be open at a time. Without
-- this, opening a second dropdown while a previous one was still open left
-- both floating panels visible and overlapping on screen — so a click could
-- land on the WRONG dropdown's buttons underneath. Holds the `close`
-- function of whichever dropdown is currently open, if any.
local currentOpenDropdownClose = nil

------------------------------------------------------------------
-- Element factory — populates a category's body with rows
------------------------------------------------------------------

local function NewElementFactory(container, onSizeChanged, registerFlag)
    local factory = {}

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    layout.Parent = container

    if onSizeChanged then
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(onSizeChanged)
    end

    -- Every element gets an increasing LayoutOrder so rows always stack in the
    -- order you called them in, even if Roblox ties same-order instances in a
    -- way you don't expect.
    local nextOrder = 0
    local function claimOrder(inst)
        nextOrder = nextOrder + 1
        inst.LayoutOrder = nextOrder
    end

    ------------------------------------------------------------------
    -- Square checkbox + label (matches the reference screenshot style)
    function factory.Toggle(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new()
        api.Value = not not opts.default

        local row = Instance.new("Frame")
        row.BackgroundTransparency = 1
        row.Size = UDim2.new(1, 0, 0, 20)
        row.Parent = container
        claimOrder(row)

        local box = Instance.new("Frame")
        box.Size = UDim2.new(0, 16, 0, 16)
        box.Position = UDim2.new(0, 0, 0.5, -8)
        box.BackgroundColor3 = Theme.PanelLight
        box.Parent = row
        Round(box, 4)
        Stroke(box, Color3.new(1, 1, 1), 1, 0.8)

        local check = Instance.new("TextLabel")
        check.BackgroundTransparency = 1
        check.Size = UDim2.new(1, 0, 1, 0)
        check.Font = Theme.FontBold
        check.TextSize = 12
        check.TextColor3 = Theme.Accent
        check.Text = "✓"
        check.TextTransparency = api.Value and 0 or 1
        check.Parent = box

        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Position = UDim2.new(0, 26, 0, 0)
        label.Size = UDim2.new(1, -26, 1, 0)
        label.Font = Theme.Font
        label.TextSize = 14
        label.TextColor3 = Theme.SubText
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Text = opts.text or "Toggle"
        label.Parent = row

        local clickArea = Instance.new("TextButton")
        clickArea.BackgroundTransparency = 1
        clickArea.Size = UDim2.new(1, 0, 1, 0)
        clickArea.Text = ""
        clickArea.Parent = row

        local function render()
            Tween(check, { TextTransparency = api.Value and 0 or 1 }, 0.1)
            Tween(box, { BackgroundColor3 = api.Value and Theme.Accent or Theme.PanelLight }, 0.1)
            Tween(check, { TextColor3 = api.Value and Color3.new(1, 1, 1) or Theme.Accent }, 0.1)
            Tween(label, { TextColor3 = api.Value and Theme.Text or Theme.SubText }, 0.1)
        end

        function api.Set(v, silent)
            v = not not v
            if v == api.Value then return end
            api.Value = v
            render()
            if not silent then api.Event:Fire(api.Value) end
        end

        clickArea.MouseButton1Click:Connect(function() api.Set(not api.Value) end)
        render()

        if opts.flag and registerFlag then
            registerFlag(opts.flag, function() return api.Value end, function(v) api.Set(v, true) end)
        end

        api.Instance = row
        function api.Destroy() row:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    -- Toggle row + a "keybind" label on the right (e.g. "Modify WalkSpeed  None")
    function factory.KeybindToggle(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new()      -- fires (enabled)
        api.BindEvent = Signal.new()  -- fires (keyName)
        api.Value = not not opts.default
        api.Bind = opts.defaultBind or "None"

        local toggle = factory.Toggle({ text = opts.text, default = opts.default })
        api.ToggleValue = toggle.Value
        toggle.Event:Connect(function(v) api.Event:Fire(v) end)

        local bindBtn = Instance.new("TextButton")
        bindBtn.AnchorPoint = Vector2.new(1, 0.5)
        bindBtn.Position = UDim2.new(1, 0, 0.5, 0)
        bindBtn.Size = UDim2.new(0, 60, 1, 0)
        bindBtn.BackgroundTransparency = 1
        bindBtn.Font = Theme.Font
        bindBtn.TextSize = 13
        bindBtn.TextColor3 = Theme.SubText
        bindBtn.Text = api.Bind
        bindBtn.TextXAlignment = Enum.TextXAlignment.Right
        bindBtn.Parent = toggle.Instance

        local listening = false
        bindBtn.MouseButton1Click:Connect(function()
            if listening then return end
            listening = true
            bindBtn.Text = "..."
            local conn
            conn = UserInputService.InputBegan:Connect(function(input, gpe)
                if gpe then return end
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    api.Bind = input.KeyCode.Name
                    bindBtn.Text = api.Bind
                    listening = false
                    conn:Disconnect()
                    api.BindEvent:Fire(api.Bind)
                end
            end)
        end)

        function api.Set(v, silent) toggle.Set(v, silent) end
        function api.SetBind(name) api.Bind = name; bindBtn.Text = name end

        api.Instance = toggle.Instance
        function api.Destroy() toggle.Destroy() end
        return api
    end

    ------------------------------------------------------------------
    function factory.Label(opts)
        opts = opts or {}
        local lbl = Instance.new("TextLabel")
        lbl.BackgroundTransparency = 1
        lbl.Size = UDim2.new(1, 0, 0, 18)
        lbl.Font = Theme.Font
        lbl.TextSize = 13
        lbl.TextColor3 = opts.color or Theme.SubText
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Text = opts.text or ""
        lbl.Parent = container
        claimOrder(lbl)

        local api = { Instance = lbl }
        function api.SetText(t) lbl.Text = t end
        function api.Destroy() lbl:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    -- A text field for freeform input (amounts, names, etc.)
    function factory.TextBox(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new() -- fires on Enter, passes text
        api.Text = ""

        local box = Instance.new("TextBox")
        box.BackgroundColor3 = Theme.PanelLight
        box.Size = UDim2.new(1, 0, 0, 34)
        box.Font = Theme.Font
        box.TextSize = 14
        box.TextColor3 = Theme.Text
        box.PlaceholderText = opts.placeholder or "Enter value"
        box.PlaceholderColor3 = Theme.SubText
        box.Text = ""
        box.ClearTextOnFocus = false
        box.Parent = container
        claimOrder(box)
        Round(box, 6)
        Stroke(box)
        Pad(box, 10)

        box:GetPropertyChangedSignal("Text"):Connect(function() api.Text = box.Text end)
        box.FocusLost:Connect(function(enterPressed)
            if enterPressed then api.Event:Fire(box.Text) end
        end)

        function api.Get() return box.Text end
        function api.Set(text) box.Text = text end

        if opts.flag and registerFlag then
            registerFlag(opts.flag, api.Get, api.Set)
        end

        api.Instance = box
        function api.Destroy() box:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    function factory.Button(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new()

        local btn = Instance.new("TextButton")
        btn.AutoButtonColor = false
        btn.BackgroundColor3 = Theme.PanelLight
        btn.Size = UDim2.new(1, 0, 0, 34)
        btn.Font = Theme.Font
        btn.TextSize = 14
        btn.TextColor3 = Theme.SubText
        btn.Text = opts.text or "Button"
        btn.Parent = container
        claimOrder(btn)
        Round(btn, 6)
        Stroke(btn)

        AddPressFlash(btn, { restTextColor = Theme.SubText })
        btn.MouseButton1Click:Connect(function() api.Event:Fire() end)

        function api.SetText(t) btn.Text = t end
        api.Instance = btn
        function api.Destroy() btn:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    -- Slider with a percentage/number readout, matching the reference bars
    function factory.Slider(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new()

        local min = opts.min or 0
        local max = opts.max or 100
        local suffix = opts.suffix or ""
        api.Value = math.clamp(opts.default or min, min, max)

        local holder = Instance.new("Frame")
        holder.BackgroundTransparency = 1
        holder.Size = UDim2.new(1, 0, 0, 36)
        holder.Parent = container
        claimOrder(holder)

        local topRow = Instance.new("Frame")
        topRow.BackgroundTransparency = 1
        topRow.Size = UDim2.new(1, 0, 0, 16)
        topRow.Parent = holder

        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, -60, 1, 0)
        label.Font = Theme.Font
        label.TextSize = 13
        label.TextColor3 = Theme.SubText
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Text = opts.text or "Slider"
        label.Parent = topRow

        local valueLabel = Instance.new("TextLabel")
        valueLabel.BackgroundTransparency = 1
        valueLabel.AnchorPoint = Vector2.new(1, 0)
        valueLabel.Position = UDim2.new(1, 0, 0, 0)
        valueLabel.Size = UDim2.new(0, 60, 1, 0)
        valueLabel.Font = Theme.Font
        valueLabel.TextSize = 13
        valueLabel.TextColor3 = Theme.Text
        valueLabel.TextXAlignment = Enum.TextXAlignment.Right
        valueLabel.Parent = topRow

        local track = Instance.new("Frame")
        track.Position = UDim2.new(0, 0, 0, 22)
        track.Size = UDim2.new(1, 0, 0, 6)
        track.BackgroundColor3 = Theme.PanelLight
        track.Parent = holder
        Round(track, 3)

        local fill = Instance.new("Frame")
        fill.BackgroundColor3 = opts.color or Theme.Accent
        fill.Size = UDim2.new(0, 0, 1, 0)
        fill.Parent = track
        Round(fill, 3)

        local knob = Instance.new("Frame")
        knob.AnchorPoint = Vector2.new(0.5, 0.5)
        knob.Size = UDim2.new(0, 12, 0, 12)
        knob.Position = UDim2.new(0, 0, 0.5, 0)
        knob.BackgroundColor3 = Color3.new(1, 1, 1)
        knob.ZIndex = 2
        knob.Parent = track
        Round(knob, 6)

        local function render()
            local alpha = (api.Value - min) / (max - min)
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            knob.Position = UDim2.new(alpha, 0, 0.5, 0)
            if suffix == "%" then
                valueLabel.Text = tostring(math.floor(alpha * 100 + 0.5)) .. "%"
            else
                valueLabel.Text = tostring(math.floor(api.Value + 0.5)) .. suffix
            end
        end

        function api.Set(v, silent)
            v = math.clamp(v, min, max)
            api.Value = v
            render()
            if not silent then api.Event:Fire(api.Value) end
        end
        render()

        local dragging = false
        local function updateFromInput(input)
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            api.Set(min + rel * (max - min))
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                updateFromInput(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateFromInput(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        if opts.flag and registerFlag then
            registerFlag(opts.flag, function() return api.Value end, function(v) api.Set(v, true) end)
        end

        api.Instance = holder
        function api.Destroy() holder:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    -- A standalone "click to rebind" row (label + current key on the right).
    -- Generic — useful for a menu-toggle keybind, an action keybind, etc.
    function factory.Keybind(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new() -- fires the new key name after a rebind
        api.Value = opts.default or "None"

        local row = Instance.new("Frame")
        row.BackgroundTransparency = 1
        row.Size = UDim2.new(1, 0, 0, 20)
        row.Parent = container
        claimOrder(row)

        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, -70, 1, 0)
        label.Font = Theme.Font
        label.TextSize = 14
        label.TextColor3 = Theme.SubText
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Text = opts.text or "Keybind"
        label.Parent = row

        local bindBtn = Instance.new("TextButton")
        bindBtn.AnchorPoint = Vector2.new(1, 0.5)
        bindBtn.Position = UDim2.new(1, 0, 0.5, 0)
        bindBtn.Size = UDim2.new(0, 90, 1, 0)
        bindBtn.BackgroundTransparency = 1
        bindBtn.Font = Theme.Font
        bindBtn.TextSize = 13
        bindBtn.TextColor3 = Theme.SubText
        bindBtn.Text = api.Value
        bindBtn.TextXAlignment = Enum.TextXAlignment.Right
        bindBtn.Parent = row
        AddPressFlash(bindBtn, { restTextColor = Theme.SubText, transparency = 0.55 })

        local listening = false
        bindBtn.MouseButton1Click:Connect(function()
            if listening then return end
            listening = true
            bindBtn.Text = "..."
            local conn
            conn = UserInputService.InputBegan:Connect(function(input, gpe)
                if gpe then return end
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    api.Value = input.KeyCode.Name
                    bindBtn.Text = api.Value
                    listening = false
                    conn:Disconnect()
                    api.Event:Fire(api.Value)
                end
            end)
        end)

        function api.Set(v) api.Value = v; bindBtn.Text = v end

        if opts.flag and registerFlag then
            registerFlag(opts.flag, function() return api.Value end, api.Set)
        end

        api.Instance = row
        function api.Destroy() row:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    -- Dropdown. The option list is a FLOATING panel parented to the top
    -- ScreenGui layer (not the category body), so opening it never grows
    -- or reflows the category it lives in and never overlaps sibling
    -- rows or a different category's content — it just floats above
    -- everything, like a native dropdown, and closes on an outside click.
    function factory.Dropdown(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new() -- fires the selected option (or the full array, for multi-select)
        local isMultiSelect = opts.multiSelect == true
        api.Value = isMultiSelect and {} or opts.default

        local hasLabel = opts.text ~= nil
        local HEAD_HEIGHT = 34
        local LABEL_HEIGHT = 16
        local LABEL_GAP = 4
        local holderHeight = hasLabel and (LABEL_HEIGHT + LABEL_GAP + HEAD_HEIGHT) or HEAD_HEIGHT

        local holder = Instance.new("Frame")
        holder.BackgroundTransparency = 1
        holder.Size = UDim2.new(1, 0, 0, holderHeight)
        holder.Parent = container
        claimOrder(holder)

        if hasLabel then
            local label = Instance.new("TextLabel")
            label.BackgroundTransparency = 1
            label.Size = UDim2.new(1, 0, 0, LABEL_HEIGHT)
            label.Font = Theme.Font
            label.TextSize = 13
            label.TextColor3 = Theme.SubText
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Text = opts.text
            label.Parent = holder
        end

        local head = Instance.new("TextButton")
        head.AutoButtonColor = false
        head.BackgroundColor3 = Theme.PanelLight
        head.Position = UDim2.new(0, 0, 0, hasLabel and (LABEL_HEIGHT + LABEL_GAP) or 0)
        head.Size = UDim2.new(1, 0, 0, HEAD_HEIGHT)
        head.Font = Theme.Font
        head.TextSize = 14
        head.TextColor3 = Theme.Text
        head.TextXAlignment = Enum.TextXAlignment.Left
        head.Parent = holder
        Round(head, 6)
        Stroke(head)
        Pad(head, 10)
        AddPressFlash(head, { restTextColor = Theme.Text })

        local chevron = Instance.new("TextLabel")
        chevron.BackgroundTransparency = 1
        chevron.AnchorPoint = Vector2.new(1, 0.5)
        chevron.Position = UDim2.new(1, -10, 0.5, 0)
        chevron.Size = UDim2.new(0, 16, 0, 16)
        chevron.Font = Theme.FontBold
        chevron.TextSize = 14
        chevron.TextColor3 = Theme.SubText
        chevron.Text = ">" -- plain ASCII, rotated — fancy unicode chevrons render as
        chevron.Rotation = 0 -- boxes/tofu on Roblox's default fonts, so we rotate a safe glyph instead
        chevron.Parent = head

        -- floating panel — sibling of the window, not a child of the category,
        -- so it renders above EVERYTHING (other categories, other tabs, etc.)
        -- and never affects anyone else's layout
        local panel = Instance.new("Frame")
        panel.Visible = false
        panel.BackgroundColor3 = Theme.Panel
        panel.Size = UDim2.new(0, 220, 0, 0)
        panel.AutomaticSize = Enum.AutomaticSize.Y
        panel.ClipsDescendants = true
        panel.ZIndex = 500
        panel.Parent = ScreenGui
        Round(panel, 8)
        Stroke(panel, Theme.Accent, 1, 0.5)

        -- A real UIListLayout + UIPadding drives panel's height here, instead
        -- of hand-placed children — that's what guarantees a correct, real
        -- gap below the last row. (The previous "bottomSpacer" frame was
        -- positioned at the panel's top-left by default, contributing zero
        -- actual bottom padding, so the list's last row sat flush against
        -- the panel's clipped edge — which is exactly what made the bottom
        -- row(s) unreliable to click.)
        local panelLayout = Instance.new("UIListLayout")
        panelLayout.SortOrder = Enum.SortOrder.LayoutOrder
        panelLayout.Padding = UDim.new(0, 8)
        panelLayout.Parent = panel
        Pad(panel, 8)

        local searchBox = Instance.new("TextBox")
        searchBox.BackgroundColor3 = Theme.PanelLight
        searchBox.Size = UDim2.new(1, 0, 0, 30)
        searchBox.LayoutOrder = 1
        searchBox.Font = Theme.Font
        searchBox.TextSize = 13
        searchBox.TextColor3 = Theme.Text
        searchBox.PlaceholderText = "Search..."
        searchBox.PlaceholderColor3 = Theme.SubText
        searchBox.ClearTextOnFocus = false
        searchBox.Text = ""
        searchBox.ZIndex = 501
        searchBox.Parent = panel
        Round(searchBox, 6)
        Pad(searchBox, 8)

        -- Fixed max height instead of AutomaticSize — a ScrollingFrame
        -- that auto-sizes to its content never has anything to scroll,
        -- since it just grows to fit everything. Capping the height here
        -- is what makes the mouse wheel actually do something once there
        -- are more options than fit — and there's no upper limit on how
        -- many options you can pass in (20 player names, a full item
        -- list, whatever); it just scrolls/searches past whatever doesn't
        -- fit in maxVisibleRows. Defaults to 6 rows; pass a bigger
        -- opts.maxVisibleRows for something like a player-name dropdown
        -- where you want more visible at once before scrolling kicks in.
        local ROW_HEIGHT = 30
        local ROW_PADDING = 4
        local maxVisibleRows = opts.maxVisibleRows or 6
        local LIST_MAX_HEIGHT = maxVisibleRows * ROW_HEIGHT + math.max(0, maxVisibleRows - 1) * ROW_PADDING

        local list = Instance.new("ScrollingFrame")
        list.BackgroundTransparency = 1
        list.BorderSizePixel = 0
        list.Size = UDim2.new(1, 0, 0, 0)
        list.LayoutOrder = 2
        list.AutomaticCanvasSize = Enum.AutomaticSize.Y
        list.CanvasSize = UDim2.new(0, 0, 0, 0)
        list.ScrollBarThickness = 3
        list.ScrollBarImageColor3 = Theme.Accent
        list.ScrollingDirection = Enum.ScrollingDirection.Y
        list.ElasticBehavior = Enum.ElasticBehavior.Never
        list.ZIndex = 501
        list.Parent = panel

        local listLayout = Instance.new("UIListLayout")
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Padding = UDim.new(0, 4)
        listLayout.Parent = list

        local isOpen = false
        local optionButtons = {}
        local allOptions = {}
        local renderStepConn = nil
        local selected = {} -- optionText -> true, only used when isMultiSelect

        local function positionPanel()
            local pos = head.AbsolutePosition
            local size = head.AbsoluteSize
            local screenSize = ScreenGui.AbsoluteSize
            local panelHeight = panel.AbsoluteSize.Y
            local y = pos.Y + size.Y + 6
            -- flip above the button if there isn't room below, so it never
            -- gets clipped off the bottom of the screen
            if y + panelHeight > screenSize.Y and pos.Y - panelHeight - 6 > 0 then
                y = pos.Y - panelHeight - 6
            end
            panel.Position = UDim2.new(0, pos.X, 0, y)
            panel.Size = UDim2.new(0, math.max(size.X, 220), 0, 0)
        end

        local function close()
            if not isOpen then return end
            isOpen = false
            panel.Visible = false
            Tween(chevron, { Rotation = 0 }, 0.1)
            if renderStepConn then renderStepConn:Disconnect(); renderStepConn = nil end
            if currentOpenDropdownClose == close then currentOpenDropdownClose = nil end
        end

        local function open()
            if isOpen then return end
            if currentOpenDropdownClose and currentOpenDropdownClose ~= close then
                currentOpenDropdownClose() -- close whichever other dropdown was open
            end
            isOpen = true
            searchBox.Text = ""
            for _, b in ipairs(optionButtons) do b.Visible = true end
            positionPanel()
            panel.Visible = true
            BringToFront(panel)
            Tween(chevron, { Rotation = 90 }, 0.1)
            -- keep the panel glued under the button if the window is dragged
            -- while the dropdown is open
            renderStepConn = RunService.RenderStepped:Connect(positionPanel)
            currentOpenDropdownClose = close
        end

        -- Gives a selected option button its highlighted look, and keeps it
        -- that way through hover (see the MouseEnter/MouseLeave guards below
        -- that skip re-tinting a selected button back to its unselected color).
        local function setOptionVisual(optBtn, isSelected)
            optBtn.BackgroundColor3 = isSelected and Theme.Accent or Theme.PanelLight
            optBtn.TextColor3 = isSelected and Color3.new(1, 1, 1) or Theme.SubText
        end

        -- Recomputes api.Value (an ordered array of every currently-selected
        -- option, in the same order as allOptions) and the head's summary
        -- text — multi-select only.
        local function refreshMultiSelectDisplay()
            local arr = {}
            for _, optionText in ipairs(allOptions) do
                if selected[optionText] then table.insert(arr, optionText) end
            end
            api.Value = arr
            if #arr == 0 then
                head.Text = opts.placeholder or "..."
            elseif #arr <= 2 then
                head.Text = table.concat(arr, ", ")
            else
                head.Text = #arr .. " selected"
            end
        end

        if isMultiSelect then
            -- api.Set(values, silent) — values is an array of option strings
            -- to mark as selected; anything not in the array is unmarked.
            function api.Set(values, silent)
                selected = {}
                for _, v in ipairs(values or {}) do selected[v] = true end
                for i, optBtn in ipairs(optionButtons) do
                    setOptionVisual(optBtn, selected[allOptions[i]])
                end
                refreshMultiSelectDisplay()
                if not silent then api.Event:Fire(api.Value) end
            end
            api.Set(opts.default or {}, true)
        else
            function api.Set(v, silent)
                api.Value = v
                head.Text = tostring(v)
                if not silent then api.Event:Fire(v) end
            end
            api.Set(opts.default or opts.placeholder or "...", true)
        end

        function api.SetOptions(options)
            for _, b in ipairs(optionButtons) do b:Destroy() end
            optionButtons = {}
            allOptions = options or {}

            if isMultiSelect then
                -- drop any selections that no longer exist in the new list
                local stillValid = {}
                for _, optionText in ipairs(allOptions) do
                    if selected[optionText] then stillValid[optionText] = true end
                end
                selected = stillValid
            end

            for i, optionText in ipairs(allOptions) do
                local optBtn = Instance.new("TextButton")
                optBtn.AutoButtonColor = false
                optBtn.BackgroundColor3 = Theme.PanelLight
                optBtn.Size = UDim2.new(1, 0, 0, 30)
                optBtn.Font = Theme.Font
                optBtn.TextSize = 13
                optBtn.TextColor3 = Theme.SubText
                optBtn.Text = optionText
                optBtn.TextXAlignment = Enum.TextXAlignment.Left
                optBtn.ZIndex = 501
                optBtn.LayoutOrder = i
                optBtn.Parent = list
                Round(optBtn, 5)
                Pad(optBtn, 8)

                if isMultiSelect then
                    setOptionVisual(optBtn, selected[optionText])
                    -- press-flash instead of hover; releases back to whatever
                    -- text color this option's CURRENT selected state wants,
                    -- not a fixed color, since selection can change on click
                    AddPressFlash(optBtn, {
                        getRestTextColor = function()
                            return selected[optionText] and Color3.new(1, 1, 1) or Theme.SubText
                        end,
                    })
                    optBtn.MouseButton1Click:Connect(function()
                        selected[optionText] = (not selected[optionText]) or nil
                        setOptionVisual(optBtn, selected[optionText])
                        refreshMultiSelectDisplay()
                        api.Event:Fire(api.Value)
                        -- panel stays open — picking several options in a row
                        -- is the whole point of multi-select
                    end)
                else
                    AddPressFlash(optBtn, { restTextColor = Theme.SubText })
                    optBtn.MouseButton1Click:Connect(function()
                        api.Set(optionText)
                        close()
                    end)
                end
                table.insert(optionButtons, optBtn)
            end

            if isMultiSelect then refreshMultiSelectDisplay() end

            local numOptions = #allOptions
            local contentHeight = numOptions > 0
                and (numOptions * ROW_HEIGHT + math.max(0, numOptions - 1) * ROW_PADDING)
                or 0
            list.Size = UDim2.new(1, 0, 0, math.min(contentHeight, LIST_MAX_HEIGHT))
        end

        searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            local query = searchBox.Text:lower()
            for i, optBtn in ipairs(optionButtons) do
                local text = tostring(allOptions[i]):lower()
                optBtn.Visible = (query == "" or text:find(query, 1, true) ~= nil)
            end
        end)

        head.MouseButton1Click:Connect(function()
            if isOpen then close() else open() end
        end)

        -- click-away-to-close: any click outside the head or the panel closes it
        UserInputService.InputBegan:Connect(function(input, gpe)
            if not isOpen then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
            task.defer(function()
                local mouse = getInsetAdjustedMouse()
                local overHead = mouse.X >= head.AbsolutePosition.X and mouse.X <= head.AbsolutePosition.X + head.AbsoluteSize.X
                    and mouse.Y >= head.AbsolutePosition.Y and mouse.Y <= head.AbsolutePosition.Y + head.AbsoluteSize.Y
                local overPanel = mouse.X >= panel.AbsolutePosition.X and mouse.X <= panel.AbsolutePosition.X + panel.AbsoluteSize.X
                    and mouse.Y >= panel.AbsolutePosition.Y and mouse.Y <= panel.AbsolutePosition.Y + panel.AbsoluteSize.Y
                if not overHead and not overPanel then
                    close()
                end
            end)
        end)

        api.SetOptions(opts.options or {})

        if opts.flag and registerFlag then
            registerFlag(opts.flag, function() return api.Value end, function(v) api.Set(v, true) end)
        end

        api.Instance = holder
        function api.Destroy()
            close()
            holder:Destroy()
            panel:Destroy()
        end
        return api
    end

    return factory
end

------------------------------------------------------------------
-- Category (collapsible section with a colored left accent bar)
------------------------------------------------------------------

local function NewCategory(parentColumn, opts, registerFlag)
    opts = opts or {}
    local api = {}
    local isOpen = opts.default_open ~= false

    local card = Instance.new("Frame")
    card.BackgroundColor3 = Theme.Panel
    card.Size = UDim2.new(1, 0, 0, 40)
    card.ClipsDescendants = true
    card.Parent = parentColumn
    Round(card, 8)
    Stroke(card, Color3.new(1, 1, 1), 1, 0.9) -- faint outline so stacked cards read as separate boxes

    local accent = Instance.new("Frame")
    accent.BackgroundColor3 = Theme.Accent
    accent.Size = UDim2.new(0, 3, 1, -12)
    accent.Position = UDim2.new(0, 0, 0, 6)
    accent.Parent = card
    Round(accent, 2)

    local header = Instance.new("TextButton")
    header.BackgroundTransparency = 1
    header.Size = UDim2.new(1, 0, 0, 40)
    header.Text = ""
    header.Parent = card

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 16, 0, 0)
    title.Size = UDim2.new(1, -46, 0, 40) -- fixed to the header strip, not the whole (growing) card
    title.Font = Theme.FontBold
    title.TextSize = 14
    title.TextColor3 = Theme.Text
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Text = opts.text or "Category"
    title.Parent = card

    local chevron = Instance.new("TextLabel")
    chevron.BackgroundTransparency = 1
    chevron.AnchorPoint = Vector2.new(1, 0.5)
    chevron.Position = UDim2.new(1, -14, 0, 20) -- fixed to the header strip's vertical center, not the card's
    chevron.Size = UDim2.new(0, 16, 0, 16)
    chevron.Font = Theme.FontBold
    chevron.TextSize = 16
    chevron.TextColor3 = Theme.SubText
    chevron.Text = ">" -- plain ASCII, rotated — fancy unicode chevrons render as boxes on Roblox's default fonts
    chevron.Rotation = isOpen and 90 or 0 -- down when expanded, right-pointing when collapsed
    chevron.Parent = card

    local body = Instance.new("Frame")
    body.BackgroundTransparency = 1
    body.Position = UDim2.new(0, 16, 0, 46)
    body.Size = UDim2.new(1, -32, 0, 0)
    -- Let Roblox drive body's real height off its UIListLayout instead of us
    -- reading AbsoluteContentSize by hand — AutomaticSize is the value that's
    -- guaranteed to be in sync with what's actually laid out.
    body.AutomaticSize = Enum.AutomaticSize.Y
    body.Parent = card

    local function resize()
        local h = body.AbsoluteSize.Y
        local target = isOpen and (46 + h + 12) or 40
        Tween(card, { Size = UDim2.new(1, 0, 0, target) }, 0.15)
    end

    local elements = NewElementFactory(body, resize, registerFlag)
    for k, v in pairs(elements) do api[k] = v end
    body:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)

    local function setOpen(v)
        isOpen = v
        Tween(chevron, { Rotation = isOpen and 90 or 0 }, 0.15)
        resize()
    end

    header.MouseButton1Click:Connect(function() setOpen(not isOpen) end)
    function api.Open() setOpen(true) end
    function api.Close() setOpen(false) end
    task.defer(resize)

    api.Instance = card
    function api.Destroy() card:Destroy() end
    return api
end

------------------------------------------------------------------
-- Two-column, auto-balancing category layout — used once per tab page
------------------------------------------------------------------

local function BuildCategoryPage(parentFrame, registerFlag)
    local pageApi = {}

    local columnGap = 12
    local leftCol = Instance.new("ScrollingFrame")
    leftCol.BackgroundTransparency = 1
    leftCol.BorderSizePixel = 0
    leftCol.Size = UDim2.new(0.5, -columnGap / 2, 1, 0)
    leftCol.CanvasSize = UDim2.new(0, 0, 0, 0)
    leftCol.AutomaticCanvasSize = Enum.AutomaticSize.Y
    leftCol.ScrollBarThickness = 3
    leftCol.ScrollBarImageColor3 = Theme.Accent
    leftCol.Parent = parentFrame

    local rightCol = Instance.new("ScrollingFrame")
    rightCol.BackgroundTransparency = 1
    rightCol.BorderSizePixel = 0
    rightCol.Position = UDim2.new(0.5, columnGap / 2, 0, 0)
    rightCol.Size = UDim2.new(0.5, -columnGap / 2, 1, 0)
    rightCol.CanvasSize = UDim2.new(0, 0, 0, 0)
    rightCol.AutomaticCanvasSize = Enum.AutomaticSize.Y
    rightCol.ScrollBarThickness = 3
    rightCol.ScrollBarImageColor3 = Theme.Accent
    rightCol.Parent = parentFrame

    for _, col in ipairs({ leftCol, rightCol }) do
        local l = Instance.new("UIListLayout")
        l.SortOrder = Enum.SortOrder.LayoutOrder
        l.Padding = UDim.new(0, 16)
        l.Parent = col
    end

    -- if there's only ever one category, stretch it across the full width
    -- instead of leaving an empty second column
    local categoryCount = 0
    local function updateSingleCategoryLayout()
        if categoryCount <= 1 then
            leftCol.Size = UDim2.new(1, 0, 1, 0)
            rightCol.Visible = false
        else
            leftCol.Size = UDim2.new(0.5, -columnGap / 2, 1, 0)
            rightCol.Visible = true
        end
    end
    updateSingleCategoryLayout()

    -- Auto-balance columns using our own running height total instead of
    -- reading AbsoluteCanvasSize at call time — that property can lag a
    -- frame behind the Instance.new() calls we just made, which was
    -- causing every category to pile into the same column.
    local leftHeight, rightHeight = 0, 0
    local categoryLayoutOrder = 0

    function pageApi.new(catOptions)
        categoryCount = categoryCount + 1
        updateSingleCategoryLayout() -- resize/reveal the column BEFORE parenting into it

        local targetCol = (leftHeight <= rightHeight) and leftCol or rightCol
        local category = NewCategory(targetCol, catOptions, registerFlag)

        categoryLayoutOrder = categoryLayoutOrder + 1
        category.Instance.LayoutOrder = categoryLayoutOrder

        -- Track this category's contribution to its column's total height as a
        -- running delta, so leftHeight/rightHeight always reflect the sum of
        -- every category in that column, not just the last one that resized.
        local lastKnownHeight = 40
        if targetCol == leftCol then leftHeight = leftHeight + lastKnownHeight
        else rightHeight = rightHeight + lastKnownHeight end

        category.Instance:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            local newHeight = category.Instance.AbsoluteSize.Y
            local delta = newHeight - lastKnownHeight
            lastKnownHeight = newHeight
            if targetCol == leftCol then leftHeight = leftHeight + delta
            else rightHeight = rightHeight + delta end
        end)

        return category
    end

    pageApi.Instance = parentFrame
    return pageApi
end

