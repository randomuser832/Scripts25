-- Window
------------------------------------------------------------------

local Library = {}

function Library.new(options)
    options = options or {}
    local api = {}

    local sizeX = options.width or 720
    local sizeY = options.height or 480

    -- outer glow wrapper
    local glow = Instance.new("Frame")
    glow.BackgroundTransparency = 1
    glow.Size = UDim2.new(0, sizeX, 0, sizeY)
    glow.Position = options.position or UDim2.new(0.5, -sizeX / 2, 0.5, -sizeY / 2)
    glow.Parent = ScreenGui

    local window = Instance.new("Frame")
    window.Active = true
    window.BackgroundColor3 = Theme.Background
    window.Size = UDim2.new(1, 0, 1, 0)
    window.ClipsDescendants = true
    window.Parent = glow
    Round(window, 12)
    Stroke(window, Theme.Accent, 1.5, 0.35)

    ------------------------------------------------------------------
    -- Header
    ------------------------------------------------------------------
    local header = Instance.new("Frame")
    header.Active = true
    header.BackgroundColor3 = Theme.Header
    header.Size = UDim2.new(1, 0, 0, 68)
    header.Parent = window

    local logo = Instance.new("Frame")
    logo.Position = UDim2.new(0, 16, 0.5, -18)
    logo.Size = UDim2.new(0, 36, 0, 36)
    logo.BackgroundColor3 = Theme.Accent
    logo.Parent = header
    Round(logo, 8)

    local logoLetter = Instance.new("TextLabel")
    logoLetter.BackgroundTransparency = 1
    logoLetter.Size = UDim2.new(1, 0, 1, 0)
    logoLetter.Font = Theme.FontBold
    logoLetter.TextSize = 18
    logoLetter.TextColor3 = Color3.new(1, 1, 1)
    logoLetter.Text = (options.title or "S"):sub(1, 1):upper()
    logoLetter.Parent = logo

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Position = UDim2.new(0, 62, 0, 12)
    titleLabel.Size = UDim2.new(0, 300, 0, 22)
    titleLabel.Font = Theme.FontBold
    titleLabel.TextSize = 17
    titleLabel.TextColor3 = Theme.Text
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Text = options.title or "Seb's UI"
    titleLabel.Parent = header

    local subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Position = UDim2.new(0, 62, 0, 34)
    subtitleLabel.Size = UDim2.new(0, 300, 0, 16)
    subtitleLabel.Font = Theme.Font
    subtitleLabel.TextSize = 12
    subtitleLabel.TextColor3 = Theme.SubText
    subtitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    subtitleLabel.Text = options.subtitle or ""
    subtitleLabel.Parent = header

    -- user identity chip, top right
    local userChip = Instance.new("Frame")
    userChip.AnchorPoint = Vector2.new(1, 0.5)
    userChip.Position = UDim2.new(1, -16, 0.5, 0)
    userChip.Size = UDim2.new(0, 40, 0, 40)
    userChip.BackgroundColor3 = Theme.PanelLight
    userChip.Parent = header
    Round(userChip, 20)
    Stroke(userChip)

    local avatarImage = Instance.new("ImageLabel")
    avatarImage.BackgroundTransparency = 1
    avatarImage.Size = UDim2.new(1, -4, 1, -4)
    avatarImage.Position = UDim2.new(0, 2, 0, 2)
    avatarImage.Parent = userChip
    Round(avatarImage, 18)

    -- notification badge, anchored to the user chip's top-right corner
    local badge = Instance.new("Frame")
    badge.AnchorPoint = Vector2.new(1, 0)
    badge.Position = UDim2.new(1, 4, 0, -4)
    badge.Size = UDim2.new(0, 16, 0, 16)
    badge.BackgroundColor3 = Color3.fromRGB(237, 66, 69)
    badge.Visible = false
    badge.ZIndex = 5
    badge.Parent = userChip
    Round(badge, 8)
    Stroke(badge, Theme.Header, 2, 0)

    local badgeLabel = Instance.new("TextLabel")
    badgeLabel.BackgroundTransparency = 1
    badgeLabel.Size = UDim2.new(1, 0, 1, 0)
    badgeLabel.Font = Theme.FontBold
    badgeLabel.TextSize = 10
    badgeLabel.TextColor3 = Color3.new(1, 1, 1)
    badgeLabel.Text = ""
    badgeLabel.ZIndex = 6
    badgeLabel.Parent = badge

    local function setAvatar()
        if not LocalPlayer then return end
        local ok, content = pcall(function()
            return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
        end)
        if ok then avatarImage.Image = content end
    end
    task.spawn(setAvatar)

    function api.Notify(count)
        if count == nil or count <= 0 then
            badge.Visible = false
            return
        end
        badge.Visible = true
        badgeLabel.Text = count > 9 and "9+" or tostring(count)
    end

    MakeDraggable(window, header)
    window.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            BringToFront(glow)
        end
    end)

    ------------------------------------------------------------------
    -- Body: two auto-balancing columns of categories
    ------------------------------------------------------------------
    local body = Instance.new("Frame")
    body.BackgroundTransparency = 1
    body.Position = UDim2.new(0, 16, 0, 80)
    body.Size = UDim2.new(1, -32, 1, -96)
    body.Parent = window

    local columnGap = 12
    local leftCol = Instance.new("ScrollingFrame")
    leftCol.BackgroundTransparency = 1
    leftCol.BorderSizePixel = 0
    leftCol.Size = UDim2.new(0.5, -columnGap / 2, 1, 0)
    leftCol.CanvasSize = UDim2.new(0, 0, 0, 0)
    leftCol.AutomaticCanvasSize = Enum.AutomaticSize.Y
    leftCol.ScrollBarThickness = 3
    leftCol.ScrollBarImageColor3 = Theme.Accent
    leftCol.Parent = body

    local rightCol = Instance.new("ScrollingFrame")
    rightCol.BackgroundTransparency = 1
    rightCol.BorderSizePixel = 0
    rightCol.Position = UDim2.new(0.5, columnGap / 2, 0, 0)
    rightCol.Size = UDim2.new(0.5, -columnGap / 2, 1, 0)
    rightCol.CanvasSize = UDim2.new(0, 0, 0, 0)
    rightCol.AutomaticCanvasSize = Enum.AutomaticSize.Y
    rightCol.ScrollBarThickness = 3
    rightCol.ScrollBarImageColor3 = Theme.Accent
    rightCol.Parent = body

    for _, col in ipairs({ leftCol, rightCol }) do
        local l = Instance.new("UIListLayout")
        l.SortOrder = Enum.SortOrder.LayoutOrder
        l.Padding = UDim.new(0, 16)
        l.Parent = col
    end

    -- if there's only ever one category, stretch it across the full width
    -- instead of leaving an empty second column
    local categoryCount = 0
    local function updateSingleCategoryLayout()
        if categoryCount <= 1 then
            leftCol.Size = UDim2.new(1, 0, 1, 0)
            rightCol.Visible = false
        else
            leftCol.Size = UDim2.new(0.5, -columnGap / 2, 1, 0)
            rightCol.Visible = true
        end
    end

    -- Auto-balance columns using our own running height total instead of
    -- reading AbsoluteCanvasSize at call time — that property can lag a
    -- frame behind the Instance.new() calls we just made, which was
    -- causing every category to pile into the same column.
    local leftHeight, rightHeight = 0, 0
    local categoryLayoutOrder = 0

    function api.new(catOptions)
        categoryCount = categoryCount + 1
        updateSingleCategoryLayout() -- resize/reveal the column BEFORE parenting into it

        local targetCol = (leftHeight <= rightHeight) and leftCol or rightCol
        local category = NewCategory(targetCol, catOptions)

        categoryLayoutOrder = categoryLayoutOrder + 1
        category.Instance.LayoutOrder = categoryLayoutOrder

        -- Track this category's contribution to its column's total height as a
        -- running delta, so leftHeight/rightHeight always reflect the sum of
        -- every category in that column, not just the last one that resized.
        local lastKnownHeight = 40
        if targetCol == leftCol then leftHeight = leftHeight + lastKnownHeight
        else rightHeight = rightHeight + lastKnownHeight end

        category.Instance:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            local newHeight = category.Instance.AbsoluteSize.Y
            local delta = newHeight - lastKnownHeight
            lastKnownHeight = newHeight
            if targetCol == leftCol then leftHeight = leftHeight + delta
            else rightHeight = rightHeight + delta end
        end)

        return category
    end
    updateSingleCategoryLayout()

    function api.Open() glow.Visible = true end
    function api.Close() glow.Visible = false end
    function api.Toggle() glow.Visible = not glow.Visible end
    function api.SetPosition(pos) glow.Position = pos end
    function api.Destroy() glow:Destroy() end

    api.Instance = window
    return api
end

return Library
