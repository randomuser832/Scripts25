--[[
    Seb's UI
    A generic, from-scratch Roblox UI library / visual shell.

    This file only builds LAYOUT AND COMPONENTS (window, collapsible
    categories, toggles, textboxes, buttons, sliders, keybind rows,
    a notification badge, and a local-player identity header).

    It does not contain any game logic, remote calls, movement changes,
    or anything else — every interactive element just exposes an
    `.Event` you connect to. What you do inside that callback (in your
    own script, for your own game) is entirely up to you.
]]

local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players          = game:GetService("Players")
local CoreGui          = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

local existing = CoreGui:FindFirstChild("SebsUI_Root")
if existing then existing:Destroy() end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SebsUI_Root"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.DisplayOrder = 100
ScreenGui.Parent = CoreGui

------------------------------------------------------------------
-- Theme
------------------------------------------------------------------

local Theme = {
    Background = Color3.fromRGB(18, 16, 24),
    Panel      = Color3.fromRGB(24, 21, 32),
    PanelLight = Color3.fromRGB(32, 28, 42),
    Header     = Color3.fromRGB(20, 18, 27),
    Accent     = Color3.fromRGB(168, 85, 247),   -- purple
    AccentDim  = Color3.fromRGB(120, 60, 180),
    Text       = Color3.fromRGB(235, 233, 240),
    SubText    = Color3.fromRGB(150, 146, 165),
    Font       = Enum.Font.Gotham,
    FontBold   = Enum.Font.GothamBold,
}

------------------------------------------------------------------
-- Utilities
------------------------------------------------------------------

local Signal = {}
Signal.__index = Signal
function Signal.new() return setmetatable({ _h = {} }, Signal) end
function Signal:Connect(fn)
    local h = self._h
    local c = { Connected = true }
    h[c] = fn
    function c:Disconnect() self.Connected = false; h[self] = nil end
    return c
end
function Signal:Fire(...)
    for c, fn in pairs(self._h) do
        if c.Connected then task.spawn(fn, ...) end
    end
end

local function Tween(inst, props, dur, style, dir)
    local tw = TweenService:Create(inst, TweenInfo.new(dur or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function Round(inst, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 6)
    c.Parent = inst
    return c
end

local function Stroke(inst, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.new(1, 1, 1)
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.88
    s.Parent = inst
    return s
end

local function Pad(inst, l, t, r, b)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, l or 0)
    p.PaddingTop = UDim.new(0, t or l or 0)
    p.PaddingRight = UDim.new(0, r or l or 0)
    p.PaddingBottom = UDim.new(0, b or t or l or 0)
    p.Parent = inst
    return p
end

local function MakeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    conn:Disconnect()
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

local topZ = 10
local function BringToFront(frame)
    topZ = topZ + 1
    frame.ZIndex = topZ
end

------------------------------------------------------------------
-- Element factory — populates a category's body with rows
------------------------------------------------------------------

local function NewElementFactory(container, onSizeChanged)
    local factory = {}

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    layout.Parent = container

    if onSizeChanged then
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(onSizeChanged)
    end

    -- Every element gets an increasing LayoutOrder so rows always stack in the
    -- order you called them in, even if Roblox ties same-order instances in a
    -- way you don't expect.
    local nextOrder = 0
    local function claimOrder(inst)
        nextOrder = nextOrder + 1
        inst.LayoutOrder = nextOrder
    end

    ------------------------------------------------------------------
    -- Square checkbox + label (matches the reference screenshot style)
    function factory.Toggle(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new()
        api.Value = not not opts.default

        local row = Instance.new("Frame")
        row.BackgroundTransparency = 1
        row.Size = UDim2.new(1, 0, 0, 20)
        row.Parent = container
        claimOrder(row)

        local box = Instance.new("Frame")
        box.Size = UDim2.new(0, 16, 0, 16)
        box.Position = UDim2.new(0, 0, 0.5, -8)
        box.BackgroundColor3 = Theme.PanelLight
        box.Parent = row
        Round(box, 4)
        Stroke(box, Color3.new(1, 1, 1), 1, 0.8)

        local check = Instance.new("TextLabel")
        check.BackgroundTransparency = 1
        check.Size = UDim2.new(1, 0, 1, 0)
        check.Font = Theme.FontBold
        check.TextSize = 12
        check.TextColor3 = Theme.Accent
        check.Text = "✓"
        check.TextTransparency = api.Value and 0 or 1
        check.Parent = box

        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Position = UDim2.new(0, 26, 0, 0)
        label.Size = UDim2.new(1, -26, 1, 0)
        label.Font = Theme.Font
        label.TextSize = 14
        label.TextColor3 = Theme.SubText
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Text = opts.text or "Toggle"
        label.Parent = row

        local clickArea = Instance.new("TextButton")
        clickArea.BackgroundTransparency = 1
        clickArea.Size = UDim2.new(1, 0, 1, 0)
        clickArea.Text = ""
        clickArea.Parent = row

        local function render()
            Tween(check, { TextTransparency = api.Value and 0 or 1 }, 0.1)
            Tween(box, { BackgroundColor3 = api.Value and Theme.Accent or Theme.PanelLight }, 0.1)
            Tween(check, { TextColor3 = api.Value and Color3.new(1, 1, 1) or Theme.Accent }, 0.1)
            Tween(label, { TextColor3 = api.Value and Theme.Text or Theme.SubText }, 0.1)
        end

        function api.Set(v, silent)
            v = not not v
            if v == api.Value then return end
            api.Value = v
            render()
            if not silent then api.Event:Fire(api.Value) end
        end

        clickArea.MouseButton1Click:Connect(function() api.Set(not api.Value) end)
        render()

        api.Instance = row
        function api.Destroy() row:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    -- Toggle row + a "keybind" label on the right (e.g. "Modify WalkSpeed  None")
    function factory.KeybindToggle(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new()      -- fires (enabled)
        api.BindEvent = Signal.new()  -- fires (keyName)
        api.Value = not not opts.default
        api.Bind = opts.defaultBind or "None"

        local toggle = factory.Toggle({ text = opts.text, default = opts.default })
        api.ToggleValue = toggle.Value
        toggle.Event:Connect(function(v) api.Event:Fire(v) end)

        local bindBtn = Instance.new("TextButton")
        bindBtn.AnchorPoint = Vector2.new(1, 0.5)
        bindBtn.Position = UDim2.new(1, 0, 0.5, 0)
        bindBtn.Size = UDim2.new(0, 60, 1, 0)
        bindBtn.BackgroundTransparency = 1
        bindBtn.Font = Theme.Font
        bindBtn.TextSize = 13
        bindBtn.TextColor3 = Theme.SubText
        bindBtn.Text = api.Bind
        bindBtn.TextXAlignment = Enum.TextXAlignment.Right
        bindBtn.Parent = toggle.Instance

        local listening = false
        bindBtn.MouseButton1Click:Connect(function()
            if listening then return end
            listening = true
            bindBtn.Text = "..."
            local conn
            conn = UserInputService.InputBegan:Connect(function(input, gpe)
                if gpe then return end
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    api.Bind = input.KeyCode.Name
                    bindBtn.Text = api.Bind
                    listening = false
                    conn:Disconnect()
                    api.BindEvent:Fire(api.Bind)
                end
            end)
        end)

        function api.Set(v, silent) toggle.Set(v, silent) end
        function api.SetBind(name) api.Bind = name; bindBtn.Text = name end

        api.Instance = toggle.Instance
        function api.Destroy() toggle.Destroy() end
        return api
    end

    ------------------------------------------------------------------
    function factory.Label(opts)
        opts = opts or {}
        local lbl = Instance.new("TextLabel")
        lbl.BackgroundTransparency = 1
        lbl.Size = UDim2.new(1, 0, 0, 18)
        lbl.Font = Theme.Font
        lbl.TextSize = 13
        lbl.TextColor3 = opts.color or Theme.SubText
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Text = opts.text or ""
        lbl.Parent = container
        claimOrder(lbl)

        local api = { Instance = lbl }
        function api.SetText(t) lbl.Text = t end
        function api.Destroy() lbl:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    -- A text field for freeform input (amounts, names, etc.)
    function factory.TextBox(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new() -- fires on Enter, passes text
        api.Text = ""

        local box = Instance.new("TextBox")
        box.BackgroundColor3 = Theme.PanelLight
        box.Size = UDim2.new(1, 0, 0, 34)
        box.Font = Theme.Font
        box.TextSize = 14
        box.TextColor3 = Theme.Text
        box.PlaceholderText = opts.placeholder or "Enter value"
        box.PlaceholderColor3 = Theme.SubText
        box.Text = ""
        box.ClearTextOnFocus = false
        box.Parent = container
        claimOrder(box)
        Round(box, 6)
        Stroke(box)
        Pad(box, 10)

        box:GetPropertyChangedSignal("Text"):Connect(function() api.Text = box.Text end)
        box.FocusLost:Connect(function(enterPressed)
            if enterPressed then api.Event:Fire(box.Text) end
        end)

        function api.Get() return box.Text end
        function api.Set(text) box.Text = text end

        api.Instance = box
        function api.Destroy() box:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    function factory.Button(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new()

        local btn = Instance.new("TextButton")
        btn.AutoButtonColor = false
        btn.BackgroundColor3 = Theme.PanelLight
        btn.Size = UDim2.new(1, 0, 0, 34)
        btn.Font = Theme.Font
        btn.TextSize = 14
        btn.TextColor3 = Theme.SubText
        btn.Text = opts.text or "Button"
        btn.Parent = container
        claimOrder(btn)
        Round(btn, 6)
        Stroke(btn)

        btn.MouseEnter:Connect(function() Tween(btn, { BackgroundColor3 = Theme.Accent, TextColor3 = Color3.new(1,1,1) }, 0.12) end)
        btn.MouseLeave:Connect(function() Tween(btn, { BackgroundColor3 = Theme.PanelLight, TextColor3 = Theme.SubText }, 0.12) end)
        btn.MouseButton1Click:Connect(function() api.Event:Fire() end)

        function api.SetText(t) btn.Text = t end
        api.Instance = btn
        function api.Destroy() btn:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    -- Slider with a percentage/number readout, matching the reference bars
    function factory.Slider(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new()

        local min = opts.min or 0
        local max = opts.max or 100
        local suffix = opts.suffix or ""
        api.Value = math.clamp(opts.default or min, min, max)

        local holder = Instance.new("Frame")
        holder.BackgroundTransparency = 1
        holder.Size = UDim2.new(1, 0, 0, 36)
        holder.Parent = container
        claimOrder(holder)

        local topRow = Instance.new("Frame")
        topRow.BackgroundTransparency = 1
        topRow.Size = UDim2.new(1, 0, 0, 16)
        topRow.Parent = holder

        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, -60, 1, 0)
        label.Font = Theme.Font
        label.TextSize = 13
        label.TextColor3 = Theme.SubText
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Text = opts.text or "Slider"
        label.Parent = topRow

        local valueLabel = Instance.new("TextLabel")
        valueLabel.BackgroundTransparency = 1
        valueLabel.AnchorPoint = Vector2.new(1, 0)
        valueLabel.Position = UDim2.new(1, 0, 0, 0)
        valueLabel.Size = UDim2.new(0, 60, 1, 0)
        valueLabel.Font = Theme.Font
        valueLabel.TextSize = 13
        valueLabel.TextColor3 = Theme.Text
        valueLabel.TextXAlignment = Enum.TextXAlignment.Right
        valueLabel.Parent = topRow

        local track = Instance.new("Frame")
        track.Position = UDim2.new(0, 0, 0, 22)
        track.Size = UDim2.new(1, 0, 0, 6)
        track.BackgroundColor3 = Theme.PanelLight
        track.Parent = holder
        Round(track, 3)

        local fill = Instance.new("Frame")
        fill.BackgroundColor3 = opts.color or Theme.Accent
        fill.Size = UDim2.new(0, 0, 1, 0)
        fill.Parent = track
        Round(fill, 3)

        local knob = Instance.new("Frame")
        knob.AnchorPoint = Vector2.new(0.5, 0.5)
        knob.Size = UDim2.new(0, 12, 0, 12)
        knob.Position = UDim2.new(0, 0, 0.5, 0)
        knob.BackgroundColor3 = Color3.new(1, 1, 1)
        knob.ZIndex = 2
        knob.Parent = track
        Round(knob, 6)

        local function render()
            local alpha = (api.Value - min) / (max - min)
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            knob.Position = UDim2.new(alpha, 0, 0.5, 0)
            if suffix == "%" then
                valueLabel.Text = tostring(math.floor(alpha * 100 + 0.5)) .. "%"
            else
                valueLabel.Text = tostring(math.floor(api.Value + 0.5)) .. suffix
            end
        end

        function api.Set(v, silent)
            v = math.clamp(v, min, max)
            api.Value = v
            render()
            if not silent then api.Event:Fire(api.Value) end
        end
        render()

        local dragging = false
        local function updateFromInput(input)
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            api.Set(min + rel * (max - min))
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                updateFromInput(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateFromInput(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        api.Instance = holder
        function api.Destroy() holder:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    -- A standalone "click to rebind" row (label + current key on the right).
    -- Generic — useful for a menu-toggle keybind, an action keybind, etc.
    function factory.Keybind(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new() -- fires the new key name after a rebind
        api.Value = opts.default or "None"

        local row = Instance.new("Frame")
        row.BackgroundTransparency = 1
        row.Size = UDim2.new(1, 0, 0, 20)
        row.Parent = container
        claimOrder(row)

        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, -70, 1, 0)
        label.Font = Theme.Font
        label.TextSize = 14
        label.TextColor3 = Theme.SubText
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Text = opts.text or "Keybind"
        label.Parent = row

        local bindBtn = Instance.new("TextButton")
        bindBtn.AnchorPoint = Vector2.new(1, 0.5)
        bindBtn.Position = UDim2.new(1, 0, 0.5, 0)
        bindBtn.Size = UDim2.new(0, 90, 1, 0)
        bindBtn.BackgroundTransparency = 1
        bindBtn.Font = Theme.Font
        bindBtn.TextSize = 13
        bindBtn.TextColor3 = Theme.SubText
        bindBtn.Text = api.Value
        bindBtn.TextXAlignment = Enum.TextXAlignment.Right
        bindBtn.Parent = row

        local listening = false
        bindBtn.MouseButton1Click:Connect(function()
            if listening then return end
            listening = true
            bindBtn.Text = "..."
            local conn
            conn = UserInputService.InputBegan:Connect(function(input, gpe)
                if gpe then return end
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    api.Value = input.KeyCode.Name
                    bindBtn.Text = api.Value
                    listening = false
                    conn:Disconnect()
                    api.Event:Fire(api.Value)
                end
            end)
        end)

        function api.Set(v) api.Value = v; bindBtn.Text = v end
        api.Instance = row
        function api.Destroy() row:Destroy() end
        return api
    end

    ------------------------------------------------------------------
    -- Expandable option list. Options can be replaced later via SetOptions
    -- (handy for a "Refresh" button next to a config selector).
    function factory.Dropdown(opts)
        opts = opts or {}
        local api = {}
        api.Event = Signal.new() -- fires the selected option
        api.Value = opts.default

        local holder = Instance.new("Frame")
        holder.BackgroundTransparency = 1
        holder.Size = UDim2.new(1, 0, 0, 34)
        holder.ClipsDescendants = true
        holder.Parent = container
        claimOrder(holder)

        local head = Instance.new("TextButton")
        head.AutoButtonColor = false
        head.BackgroundColor3 = Theme.PanelLight
        head.Size = UDim2.new(1, 0, 0, 34)
        head.Font = Theme.Font
        head.TextSize = 14
        head.TextColor3 = Theme.Text
        head.TextXAlignment = Enum.TextXAlignment.Left
        head.Parent = holder
        Round(head, 6)
        Stroke(head)
        Pad(head, 10)

        local chevron = Instance.new("TextLabel")
        chevron.BackgroundTransparency = 1
        chevron.AnchorPoint = Vector2.new(1, 0.5)
        chevron.Position = UDim2.new(1, -10, 0.5, 0)
        chevron.Size = UDim2.new(0, 16, 0, 16)
        chevron.Font = Theme.Font
        chevron.TextSize = 12
        chevron.TextColor3 = Theme.SubText
        chevron.Text = "⌄"
        chevron.Parent = head

        local list = Instance.new("Frame")
        list.BackgroundTransparency = 1
        list.Position = UDim2.new(0, 0, 0, 38)
        list.Size = UDim2.new(1, 0, 0, 0)
        list.AutomaticSize = Enum.AutomaticSize.Y
        list.Parent = holder

        local listLayout = Instance.new("UIListLayout")
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Padding = UDim.new(0, 4)
        listLayout.Parent = list

        local isOpen = false
        local optionButtons = {}

        local function resizeHolder()
            local target = isOpen and (34 + 4 + list.AbsoluteSize.Y) or 34
            Tween(holder, { Size = UDim2.new(1, 0, 0, target) }, 0.12)
        end

        function api.Set(v, silent)
            api.Value = v
            head.Text = tostring(v)
            if not silent then api.Event:Fire(v) end
        end
        api.Set(opts.default or opts.placeholder or "...", true)

        function api.SetOptions(options)
            for _, b in ipairs(optionButtons) do b:Destroy() end
            optionButtons = {}
            for _, optionText in ipairs(options or {}) do
                local optBtn = Instance.new("TextButton")
                optBtn.AutoButtonColor = false
                optBtn.BackgroundColor3 = Theme.Panel
                optBtn.Size = UDim2.new(1, 0, 0, 28)
                optBtn.Font = Theme.Font
                optBtn.TextSize = 13
                optBtn.TextColor3 = Theme.SubText
                optBtn.Text = optionText
                optBtn.Parent = list
                Round(optBtn, 5)
                optBtn.MouseButton1Click:Connect(function()
                    api.Set(optionText)
                    isOpen = false
                    chevron.Text = "⌄"
                    resizeHolder()
                end)
                table.insert(optionButtons, optBtn)
            end
            resizeHolder()
        end

        head.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            chevron.Text = isOpen and "›" or "⌄"
            resizeHolder()
        end)

        api.SetOptions(opts.options or {})
        api.Instance = holder
        function api.Destroy() holder:Destroy() end
        return api
    end

    return factory
end

------------------------------------------------------------------
-- Category (collapsible section with a colored left accent bar)
------------------------------------------------------------------

local function NewCategory(parentColumn, opts)
    opts = opts or {}
    local api = {}
    local isOpen = opts.default_open ~= false

    local card = Instance.new("Frame")
    card.BackgroundColor3 = Theme.Panel
    card.Size = UDim2.new(1, 0, 0, 40)
    card.ClipsDescendants = true
    card.Parent = parentColumn
    Round(card, 8)
    Stroke(card, Color3.new(1, 1, 1), 1, 0.9) -- faint outline so stacked cards read as separate boxes

    local accent = Instance.new("Frame")
    accent.BackgroundColor3 = Theme.Accent
    accent.Size = UDim2.new(0, 3, 1, -12)
    accent.Position = UDim2.new(0, 0, 0, 6)
    accent.Parent = card
    Round(accent, 2)

    local header = Instance.new("TextButton")
    header.BackgroundTransparency = 1
    header.Size = UDim2.new(1, 0, 0, 40)
    header.Text = ""
    header.Parent = card

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 16, 0, 0)
    title.Size = UDim2.new(1, -46, 0, 40) -- fixed to the header strip, not the whole (growing) card
    title.Font = Theme.FontBold
    title.TextSize = 14
    title.TextColor3 = Theme.Text
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Text = opts.text or "Category"
    title.Parent = card

    local chevron = Instance.new("TextLabel")
    chevron.BackgroundTransparency = 1
    chevron.AnchorPoint = Vector2.new(1, 0.5)
    chevron.Position = UDim2.new(1, -14, 0, 20) -- fixed to the header strip's vertical center, not the card's
    chevron.Size = UDim2.new(0, 16, 0, 16)
    chevron.Font = Theme.Font
    chevron.TextSize = 14
    chevron.TextColor3 = Theme.SubText
    chevron.Text = isOpen and "⌄" or "›" -- down when expanded, right-pointing when collapsed
    chevron.Parent = card

    local body = Instance.new("Frame")
    body.BackgroundTransparency = 1
    body.Position = UDim2.new(0, 16, 0, 46)
    body.Size = UDim2.new(1, -32, 0, 0)
    -- Let Roblox drive body's real height off its UIListLayout instead of us
    -- reading AbsoluteContentSize by hand — AutomaticSize is the value that's
    -- guaranteed to be in sync with what's actually laid out.
    body.AutomaticSize = Enum.AutomaticSize.Y
    body.Parent = card

    local function resize()
        local h = body.AbsoluteSize.Y
        local target = isOpen and (46 + h + 12) or 40
        Tween(card, { Size = UDim2.new(1, 0, 0, target) }, 0.15)
    end

    local elements = NewElementFactory(body, resize)
    for k, v in pairs(elements) do api[k] = v end
    body:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)

    local function setOpen(v)
        isOpen = v
        chevron.Text = isOpen and "⌄" or "›"
        resize()
    end

    header.MouseButton1Click:Connect(function() setOpen(not isOpen) end)
    function api.Open() setOpen(true) end
    function api.Close() setOpen(false) end
    task.defer(resize)

    api.Instance = card
    function api.Destroy() card:Destroy() end
    return api
end

------------------------------------------------------------------
-- Two-column, auto-balancing category layout — used once per tab page
------------------------------------------------------------------

local function BuildCategoryPage(parentFrame)
    local pageApi = {}

    local columnGap = 12
    local leftCol = Instance.new("ScrollingFrame")
    leftCol.BackgroundTransparency = 1
    leftCol.BorderSizePixel = 0
    leftCol.Size = UDim2.new(0.5, -columnGap / 2, 1, 0)
    leftCol.CanvasSize = UDim2.new(0, 0, 0, 0)
    leftCol.AutomaticCanvasSize = Enum.AutomaticSize.Y
    leftCol.ScrollBarThickness = 3
    leftCol.ScrollBarImageColor3 = Theme.Accent
    leftCol.Parent = parentFrame

    local rightCol = Instance.new("ScrollingFrame")
    rightCol.BackgroundTransparency = 1
    rightCol.BorderSizePixel = 0
    rightCol.Position = UDim2.new(0.5, columnGap / 2, 0, 0)
    rightCol.Size = UDim2.new(0.5, -columnGap / 2, 1, 0)
    rightCol.CanvasSize = UDim2.new(0, 0, 0, 0)
    rightCol.AutomaticCanvasSize = Enum.AutomaticSize.Y
    rightCol.ScrollBarThickness = 3
    rightCol.ScrollBarImageColor3 = Theme.Accent
    rightCol.Parent = parentFrame

    for _, col in ipairs({ leftCol, rightCol }) do
        local l = Instance.new("UIListLayout")
        l.SortOrder = Enum.SortOrder.LayoutOrder
        l.Padding = UDim.new(0, 16)
        l.Parent = col
    end

    -- if there's only ever one category, stretch it across the full width
    -- instead of leaving an empty second column
    local categoryCount = 0
    local function updateSingleCategoryLayout()
        if categoryCount <= 1 then
            leftCol.Size = UDim2.new(1, 0, 1, 0)
            rightCol.Visible = false
        else
            leftCol.Size = UDim2.new(0.5, -columnGap / 2, 1, 0)
            rightCol.Visible = true
        end
    end
    updateSingleCategoryLayout()

    -- Auto-balance columns using our own running height total instead of
    -- reading AbsoluteCanvasSize at call time — that property can lag a
    -- frame behind the Instance.new() calls we just made, which was
    -- causing every category to pile into the same column.
    local leftHeight, rightHeight = 0, 0
    local categoryLayoutOrder = 0

    function pageApi.new(catOptions)
        categoryCount = categoryCount + 1
        updateSingleCategoryLayout() -- resize/reveal the column BEFORE parenting into it

        local targetCol = (leftHeight <= rightHeight) and leftCol or rightCol
        local category = NewCategory(targetCol, catOptions)

        categoryLayoutOrder = categoryLayoutOrder + 1
        category.Instance.LayoutOrder = categoryLayoutOrder

        -- Track this category's contribution to its column's total height as a
        -- running delta, so leftHeight/rightHeight always reflect the sum of
        -- every category in that column, not just the last one that resized.
        local lastKnownHeight = 40
        if targetCol == leftCol then leftHeight = leftHeight + lastKnownHeight
        else rightHeight = rightHeight + lastKnownHeight end

        category.Instance:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            local newHeight = category.Instance.AbsoluteSize.Y
            local delta = newHeight - lastKnownHeight
            lastKnownHeight = newHeight
            if targetCol == leftCol then leftHeight = leftHeight + delta
            else rightHeight = rightHeight + delta end
        end)

        return category
    end

    pageApi.Instance = parentFrame
    return pageApi
end

------------------------------------------------------------------
-- Window
------------------------------------------------------------------

local Library = {}

function Library.new(options)
    options = options or {}
    local api = {}

    local sizeX = options.width or 720
    local sizeY = options.height or 480

    -- outer glow wrapper
    local glow = Instance.new("Frame")
    glow.BackgroundTransparency = 1
    glow.Size = UDim2.new(0, sizeX, 0, sizeY)
    glow.Position = options.position or UDim2.new(0.5, -sizeX / 2, 0.5, -sizeY / 2)
    glow.Parent = ScreenGui

    local window = Instance.new("Frame")
    window.Active = true
    window.BackgroundColor3 = Theme.Background
    window.Size = UDim2.new(1, 0, 1, 0)
    window.ClipsDescendants = true
    window.Parent = glow
    Round(window, 12)
    Stroke(window, Theme.Accent, 1.5, 0.35)

    ------------------------------------------------------------------
    -- Header
    ------------------------------------------------------------------
    local header = Instance.new("Frame")
    header.Active = true
    header.BackgroundColor3 = Theme.Header
    header.Size = UDim2.new(1, 0, 0, 68)
    header.Parent = window

    local logo = Instance.new("Frame")
    logo.Position = UDim2.new(0, 16, 0.5, -18)
    logo.Size = UDim2.new(0, 36, 0, 36)
    logo.BackgroundColor3 = Theme.Accent
    logo.Parent = header
    Round(logo, 8)

    local logoLetter = Instance.new("TextLabel")
    logoLetter.BackgroundTransparency = 1
    logoLetter.Size = UDim2.new(1, 0, 1, 0)
    logoLetter.Font = Theme.FontBold
    logoLetter.TextSize = 18
    logoLetter.TextColor3 = Color3.new(1, 1, 1)
    logoLetter.Text = (options.title or "S"):sub(1, 1):upper()
    logoLetter.Parent = logo

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Position = UDim2.new(0, 62, 0, 12)
    titleLabel.Size = UDim2.new(0, 300, 0, 22)
    titleLabel.Font = Theme.FontBold
    titleLabel.TextSize = 17
    titleLabel.TextColor3 = Theme.Text
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Text = options.title or "Seb's UI"
    titleLabel.Parent = header

    local subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Position = UDim2.new(0, 62, 0, 34)
    subtitleLabel.Size = UDim2.new(0, 300, 0, 16)
    subtitleLabel.Font = Theme.Font
    subtitleLabel.TextSize = 12
    subtitleLabel.TextColor3 = Theme.SubText
    subtitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    subtitleLabel.Text = options.subtitle or ""
    subtitleLabel.Parent = header

    -- user identity chip, top right
    local userChip = Instance.new("Frame")
    userChip.AnchorPoint = Vector2.new(1, 0.5)
    userChip.Position = UDim2.new(1, -16, 0.5, 0)
    userChip.Size = UDim2.new(0, 40, 0, 40)
    userChip.BackgroundColor3 = Theme.PanelLight
    userChip.Parent = header
    Round(userChip, 20)
    Stroke(userChip)

    local avatarImage = Instance.new("ImageLabel")
    avatarImage.BackgroundTransparency = 1
    avatarImage.Size = UDim2.new(1, -4, 1, -4)
    avatarImage.Position = UDim2.new(0, 2, 0, 2)
    avatarImage.Parent = userChip
    Round(avatarImage, 18)

    local function setAvatar()
        if not LocalPlayer then return end
        local ok, content = pcall(function()
            return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
        end)
        if ok then avatarImage.Image = content end
    end
    task.spawn(setAvatar)

    MakeDraggable(window, header)
    window.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            BringToFront(glow)
        end
    end)

    ------------------------------------------------------------------
    -- Icon tab bar + one page per tab (each page is its own two-column
    -- category layout, built with BuildCategoryPage above)
    ------------------------------------------------------------------
    local tabBar = Instance.new("Frame")
    tabBar.BackgroundTransparency = 1
    tabBar.Position = UDim2.new(0, 16, 0, 76)
    tabBar.Size = UDim2.new(1, -32, 0, 36)
    tabBar.Parent = window

    local tabBarLayout = Instance.new("UIListLayout")
    tabBarLayout.FillDirection = Enum.FillDirection.Horizontal
    tabBarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabBarLayout.Padding = UDim.new(0, 8)
    tabBarLayout.Parent = tabBar

    local pagesContainer = Instance.new("Frame")
    pagesContainer.BackgroundTransparency = 1
    pagesContainer.Position = UDim2.new(0, 16, 0, 122)
    pagesContainer.Size = UDim2.new(1, -32, 1, -138)
    pagesContainer.Parent = window

    local tabs = {}
    local selectedTab = nil

    local function selectTab(id)
        selectedTab = id
        for _, t in ipairs(tabs) do
            local isSelected = (t.id == id)
            t.page.Visible = isSelected
            Tween(t.button, {
                BackgroundColor3 = isSelected and Theme.Accent or Theme.PanelLight,
                TextColor3 = isSelected and Color3.new(1, 1, 1) or Theme.SubText,
            }, 0.1)
        end
    end

    -- Create a new tab. opts.icon is a single glyph/emoji shown in the tab
    -- bar (e.g. "👤" or "⚙"), opts.name is used for the tooltip-ish text
    -- inside longer tab buttons if you pass opts.wide = true.
    function api.Tab(opts)
        opts = opts or {}

        local page = Instance.new("Frame")
        page.BackgroundTransparency = 1
        page.Size = UDim2.new(1, 0, 1, 0)
        page.Visible = false
        page.Parent = pagesContainer

        local btn = Instance.new("TextButton")
        btn.AutoButtonColor = false
        btn.BackgroundColor3 = Theme.PanelLight
        btn.Size = opts.wide and UDim2.new(0, 120, 1, 0) or UDim2.new(0, 36, 1, 0)
        btn.Font = Theme.FontBold
        btn.TextSize = 16
        btn.TextColor3 = Theme.SubText
        btn.Text = opts.wide and ((opts.icon and (opts.icon .. "  ") or "") .. (opts.name or "Tab")) or (opts.icon or "•")
        btn.Parent = tabBar
        Round(btn, 8)

        local id = #tabs + 1
        local pageApi = BuildCategoryPage(page)
        tabs[id] = { id = id, page = page, button = btn, pageApi = pageApi }
        btn.MouseButton1Click:Connect(function() selectTab(id) end)

        local tabApi = { new = pageApi.new, Instance = page, Button = btn }

        if id == 1 then selectTab(id) end
        return tabApi
    end

    -- Fallback for simple, tab-less usage: window.new(...) works exactly like
    -- before by silently creating a single default tab the first time it's called.
    function api.new(catOptions)
        if not tabs[1] then api.Tab({ icon = "≡" }) end
        return tabs[1].pageApi.new(catOptions)
    end

    -- Built-in Settings + Configs tab: menu keybind capture, unload button,
    -- fade/animation sliders, and a config selector wired to events you
    -- connect your own save/load logic to.
    function api.SettingsTab(opts)
        opts = opts or {}
        local tab = api.Tab({ name = opts.name or "Settings", icon = opts.icon or "⚙" })

        local settingsCat = tab.new({ text = "Settings" })
        local keybind = settingsCat.Keybind({ text = "Menu Keybind", default = opts.keybind or "RightControl" })
        local unloadBtn = settingsCat.Button({ text = "Unload" })
        local fadeSlider = settingsCat.Slider({ text = "Fade Time", min = 0, max = 100, default = (opts.fadeTime or 0.2) * 100, suffix = "s" })
        local animSlider = settingsCat.Slider({ text = "Animation Speed", min = 0, max = 100, default = (opts.animationSpeed or 0.25) * 100, suffix = "s" })

        local configsCat = tab.new({ text = "Configs" })
        local configDropdown = configsCat.Dropdown({ options = opts.configs or {}, placeholder = "..." })
        local nameBox = configsCat.TextBox({ placeholder = "Config name" })
        local createBtn = configsCat.Button({ text = "Create" })
        local loadBtn = configsCat.Button({ text = "Load" })
        local saveBtn = configsCat.Button({ text = "Save" })
        local deleteBtn = configsCat.Button({ text = "Delete" })
        local refreshBtn = configsCat.Button({ text = "Refresh" })

        local settingsApi = {}
        settingsApi.KeybindEvent = keybind.Event
        settingsApi.UnloadEvent = unloadBtn.Event
        settingsApi.FadeTimeEvent = fadeSlider.Event
        settingsApi.AnimationSpeedEvent = animSlider.Event
        settingsApi.ConfigCreateEvent = Signal.new()
        settingsApi.ConfigLoadEvent = Signal.new()
        settingsApi.ConfigSaveEvent = Signal.new()
        settingsApi.ConfigDeleteEvent = Signal.new()
        settingsApi.ConfigRefreshEvent = Signal.new()

        createBtn.Event:Connect(function() settingsApi.ConfigCreateEvent:Fire(nameBox.Get()) end)
        loadBtn.Event:Connect(function() settingsApi.ConfigLoadEvent:Fire(configDropdown.Value) end)
        saveBtn.Event:Connect(function() settingsApi.ConfigSaveEvent:Fire(configDropdown.Value) end)
        deleteBtn.Event:Connect(function() settingsApi.ConfigDeleteEvent:Fire(configDropdown.Value) end)
        refreshBtn.Event:Connect(function() settingsApi.ConfigRefreshEvent:Fire() end)

        -- sensible defaults: the menu keybind actually toggles the window,
        -- and Unload actually tears the UI down — override by disconnecting
        -- and reconnecting your own handlers if you want different behavior
        keybind.Event:Connect(function(key) api.SetMenuKeybind(key) end)
        unloadBtn.Event:Connect(function() api.Destroy() end)

        function settingsApi.SetConfigList(list) configDropdown.SetOptions(list) end
        settingsApi.Tab = tab
        settingsApi.MenuKeybind = keybind
        settingsApi.ConfigDropdown = configDropdown
        return settingsApi
    end

    ------------------------------------------------------------------
    -- Menu keybind (defaults to RightControl) — toggles the whole window
    ------------------------------------------------------------------
    local menuKeyCode = Enum.KeyCode.RightControl
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == menuKeyCode then
            api.Toggle()
        end
    end)
    function api.SetMenuKeybind(keyCodeName)
        local ok, code = pcall(function() return Enum.KeyCode[keyCodeName] end)
        if ok and code then menuKeyCode = code end
    end

    function api.Open() glow.Visible = true end
    function api.Close() glow.Visible = false end
    function api.Toggle() glow.Visible = not glow.Visible end
    function api.SetPosition(pos) glow.Position = pos end
    function api.Destroy() glow:Destroy() end

    api.Instance = window
    return api
end

return Library
